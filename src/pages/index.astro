---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Stats from '../components/home/Stats.astro';
import Services from '../components/home/Services.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import CTA from '../components/home/CTA.astro';
import type { Language } from '../utils/url';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props; // ✅ Por defecto español
const isEs = lang === 'es';
---

<MainLayout title={isEs ? "Daniel Pérez Navarro - Portfolio Profesional" : "Daniel Pérez Navarro - Professional Portfolio"}>
  <Header currentPage="/" lang={lang} />
  
  <main>
    <Hero lang={lang} />
    <Stats lang={lang} />
    <Services lang={lang} />
    <FeaturedProjects lang={lang} />
    <CTA lang={lang} />
  </main>
  
  <Footer lang={lang} />
</MainLayout>