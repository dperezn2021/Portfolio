---
// src/pages/sobre-mi.astro
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Profile from '../components/about/Profile.astro';
import Skills from '../components/about/Skills.astro';
import ToolsGrid from '../components/about/ToolsGrid.astro';
import DigitalCV from '../components/about/DigitalCV.astro';
import type { Language } from '../utils/url';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<MainLayout title={isEs ? 'Sobre Mí | Daniel Pérez Navarro' : 'About Me | Daniel Pérez Navarro'}>
  <Header currentPage="/sobre-mi" lang={lang} />
  
  <main class="pt-24">
    <Profile lang={lang} />
    <Skills lang={lang} />
    <DigitalCV lang={lang} />
    <ToolsGrid lang={lang} />
  </main>
  
  <Footer lang={lang} />
</MainLayout>