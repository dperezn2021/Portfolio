---
// src/pages/proyectos/[slug].astro
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import ProjectGallery from "../../components/projects/ProjectGallery.astro";
import ProjectResources from "../../components/projects/ProjectResources.astro";
import FeaturedMedia from "../../components/projects/FeaturedMedia.astro";
import CollectionGrid from "../../components/projects/CollectionGrid.astro";
import ProjectHero from "../../components/projects/detail/ProjectHero.astro";
import ProjectStory from "../../components/projects/detail/ProjectStory.astro";
import ProjectFacts from "../../components/projects/detail/ProjectFacts.astro";
import ProjectHighlights from "../../components/projects/detail/ProjectHighlights.astro";
import RelatedProjects from "../../components/projects/detail/RelatedProjects.astro";
import SectionHeading from "../../components/projects/detail/SectionHeading.astro";
import { getPublicItems } from "../../data/collections";
import { publicProjects } from "../../data/projects";
import { t } from "../../data/translations";
import type { Project, ProjectTextField } from "../../data/projects";
import type { Language } from "../../utils/url";
import { withBasePath } from '../../utils/paths';
import { getRelatedProjects } from '../../utils/related-projects';

export async function getStaticPaths() {
  return publicProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project, lang: 'es' as Language },
  }));
}

interface Props {
  project: Project;
  lang?: Language;
}

const { project, lang = 'es' } = Astro.props;
const collectionItems = getPublicItems(project.slug);
const relatedProjects = getRelatedProjects(project, publicProjects, 3);

// Texto en el idioma activo; el español vive en la propia entrada y el inglés en `project.en`.
const text = (field: ProjectTextField) => (lang === 'en' ? project.en?.[field] ?? project[field] : project[field]);
const title = text('title') ?? project.title;
const description = text('description') ?? project.description;

// Contenido principal: usa `featuredMedia` si el proyecto lo define; si no,
// la portada (`cover`) sigue haciendo de contenido principal como siempre.
const featuredItem = project.featuredMedia ?? (project.cover ? { type: 'image' as const, src: project.cover } : null);

// La galería mezcla imágenes y vídeos (nunca PDFs, repos ni enlaces: eso va
// en ProjectResources). Se excluye el elemento ya mostrado como destacado
// para no duplicar contenido entre el bloque principal y la galería.
const galleryMedia = project.gallery
  .filter((item) => (item.type === 'image' || item.type === 'video') && Boolean(item.src))
  .filter((item) => !featuredItem || item.src !== featuredItem.src)
  .map((item) => ({
    ...item,
    src: item.src ? withBasePath(item.src) : undefined,
    poster: item.poster ? withBasePath(item.poster) : undefined,
  }));

const titleKey = `project.${project.slug}.title`;
---

<MainLayout
  title={`${title} | Daniel Pérez Navarro`}
  description={description}
  ogTitle={title}
  ogDescription={description}
  ogImage={project.cover ? withBasePath(project.cover) : undefined}
  ogUrl={withBasePath(`/proyectos/${project.slug}`)}
>
  <Header currentPage="/proyectos" lang={lang} />

  <main class="pt-24">
    <article class="mx-auto max-w-6xl px-4 sm:px-6 py-12 md:py-20">
      <ProjectHero project={project} title={title} description={description} lang={lang} />

      {featuredItem && (
        <section class="mb-12">
          <FeaturedMedia item={featuredItem} title={title} titleKey={titleKey} />
        </section>
      )}

      {galleryMedia.length > 0 && (
        <section class="mb-16">
          <ProjectGallery items={galleryMedia} alt={title} altTranslationKey={titleKey} config={project.galleryConfig || {}} />
        </section>
      )}

      {collectionItems.length > 0 && (
        <section class="mb-16">
          <SectionHeading emoji="🎮" titleKey="collection.games_title" lang={lang} />
          <CollectionGrid projectSlug={project.slug} items={collectionItems} lang={lang} />
        </section>
      )}

      {project.resources.length > 0 && (
        <section class="mb-16">
          <SectionHeading emoji="🔗" titleKey="project.resources_title" subtitleKey="project.resources_subtitle" lang={lang} />
          <ProjectResources resources={project.resources} lang={lang} />
        </section>
      )}

      {(project.story?.length ?? 0) > 0 && (
        <section class="mb-16">
          <ProjectStory steps={project.story ?? []} lang={lang} />
        </section>
      )}

      <section class="mb-16 grid grid-cols-1 gap-6 md:grid-cols-3">
        <ProjectFacts
          slug={project.slug}
          role={text('role')}
          team={text('team')}
          duration={text('duration')}
          technologies={project.technologies}
          lang={lang}
        />
      </section>

      <ProjectHighlights skillGains={project.skillGains ?? []} highlights={project.highlights ?? []} lang={lang} />

      <RelatedProjects related={relatedProjects} lang={lang} />

      <div class="flex flex-wrap gap-4 pt-4 border-t border-gray-200 dark:border-white/10">
        <a href={withBasePath('/proyectos')} class="btn-primary" data-i18n="project.back">
          {t(lang, 'project.back')}
        </a>
      </div>
    </article>
  </main>

  <Footer lang={lang} />
</MainLayout>
