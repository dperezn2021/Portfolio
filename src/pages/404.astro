---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { withBasePath } from '../utils/paths';
---

<MainLayout title="Página no encontrada | Daniel Pérez Navarro">
  <Header currentPage="" lang="es" />

  <main class="pt-24">
    <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center gap-6 px-6 py-20 text-center">
      <p class="text-6xl font-bold text-cyan-600 dark:text-cyan-400">404</p>
      <h1 class="text-2xl font-bold text-black md:text-3xl" data-i18n="notfound.title">Esta página no existe</h1>
      <p class="text-black/70" data-i18n="notfound.text">
        Puede que el enlace esté roto o que el proyecto haya cambiado de dirección.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={withBasePath('/')} class="btn-primary" data-i18n="notfound.home">Volver al inicio</a>
        <a href={withBasePath('/proyectos')} class="btn-secondary" data-i18n="notfound.projects">Ver proyectos</a>
      </div>
    </section>
  </main>

  <Footer lang="es" />
</MainLayout>
