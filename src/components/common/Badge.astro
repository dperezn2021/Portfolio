---
interface Props {
  color?: 'cyan' | 'purple';
  i18nKey?: string;
}

const { color = 'cyan', i18nKey } = Astro.props;

const colors = {
  cyan: 'border-cyan-400/30 bg-cyan-400/10 text-cyan-400 dark:border-cyan-400/30 dark:bg-cyan-400/10 dark:text-cyan-400',
  purple: 'border-fuchsia-500/30 bg-fuchsia-500/10 text-fuchsia-400 dark:border-fuchsia-500/30 dark:bg-fuchsia-500/10 dark:text-fuchsia-400',
};
---

<div
  class={`inline-flex items-center gap-2 rounded-full border px-4 py-1.5 ${colors[color]}`}
  data-i18n={i18nKey}
>
  <span class="h-2 w-2 animate-pulse rounded-full bg-current"></span>
  <span class="text-xs font-bold uppercase tracking-wider">
    <slot />
  </span>
</div>