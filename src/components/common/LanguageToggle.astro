---
import type { Language } from '../../utils/url';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<div
  id="lang-toggle"
  class="relative flex h-8 w-20 cursor-pointer select-none items-center rounded-full border border-gray-200 bg-white p-0.5 shadow-sm transition-colors dark:border-white/10 dark:bg-zinc-800/50 dark:shadow-none"
>
  <div
    data-lang-slider
    class="absolute top-0.5 bottom-0.5 w-[calc(50%-4px)] rounded-full bg-cyan-500 transition-all duration-300 dark:bg-cyan-400"
    style={{
      left: lang === 'es' ? '2px' : 'calc(50% + 2px)',
    }}
  ></div>

  <span
    data-lang-option="es"
    class:list={[
      'relative z-10 text-[10px] font-bold transition-colors w-1/2 text-center',
      lang === 'es'
        ? 'text-white dark:text-black'
        : 'text-black dark:text-black',
    ]}
  >
    ES
  </span>

  <span
    data-lang-option="en"
    class:list={[
      'relative z-10 text-[10px] font-bold transition-colors w-1/2 text-center',
      lang === 'en'
        ? 'text-white dark:text-black'
        : 'text-black dark:text-black',
    ]}
  >
    ENG
  </span>
</div>
