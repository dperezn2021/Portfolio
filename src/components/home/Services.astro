---
import SectionTitle from '../common/SectionTitle.astro';

interface Service {
  icon: string;
  titleKey: string;
  descKey: string;
}

const services: Service[] = [
  { icon: '3d_rotation', titleKey: 'services.s1_title', descKey: 'services.s1_desc' },
  { icon: 'code', titleKey: 'services.s2_title', descKey: 'services.s2_desc' },
  { icon: 'movie', titleKey: 'services.s3_title', descKey: 'services.s3_desc' },
  { icon: 'mouse', titleKey: 'services.s4_title', descKey: 'services.s4_desc' },
];
---

<section class="py-16 transition-colors duration-300 md:py-20" id="services">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionTitle titleKey="services.title" subtitleKey="services.subtitle" centered>
      <span slot="title">Especialidades</span>
      <span slot="subtitle">Experiencia técnica para productos digitales de próxima generación.</span>
    </SectionTitle>

    <div class="mt-10 md:mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <div class="rounded-xl border border-cyan-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-2 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-cyan-100 dark:bg-cyan-400/10">
            <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">
              {service.icon}
            </span>
          </div>
          <h3 class="font-grotesk text-lg font-bold text-black dark:text-white md:text-xl" data-i18n={service.titleKey}>
            Diseño 3D
          </h3>
          <p class="mt-2 text-sm text-black dark:text-black" data-i18n={service.descKey}>
            Modelado hard-surface, escultura y texturizado PBR para assets listos para juegos.
          </p>
        </div>
      ))}
    </div>
  </div>
</section>