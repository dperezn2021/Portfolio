---
// Buscador global: índice generado en build (/search-index.json), búsqueda local en el navegador.
import SectionTitle from '../common/SectionTitle.astro';
import { t } from '../../data/translations';
import { withBasePath } from '../../utils/paths';
import type { Language } from '../../utils/url';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const indexUrl = withBasePath('/search-index.json');
// Términos de ejemplo: todos devuelven resultados reales (se comprueban al revisar el buscador).
const suggestions = ['Web', 'Master', 'Figma', 'IA', 'Game', 'Jira'];
---

<section id="buscador" class="scroll-mt-20 py-16 transition-colors duration-300 md:py-20" data-search-root data-index-url={indexUrl}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <SectionTitle titleKey="search.title" subtitleKey="search.subtitle" centered>
      <span slot="title">{t(lang, 'search.title')}</span>
      <span slot="subtitle">{t(lang, 'search.subtitle')}</span>
    </SectionTitle>

    <div class="mt-8" role="search">
      <label for="global-search-input" class="sr-only" data-i18n="search.label">{t(lang, 'search.label')}</label>
      <div class="relative">
        <span class="material-symbols-outlined pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-cyan-600 dark:text-cyan-400" aria-hidden="true">search</span>
        <input
          id="global-search-input"
          type="text"
          inputmode="search"
          role="combobox"
          aria-expanded="false"
          aria-controls="global-search-results"
          aria-autocomplete="list"
          aria-describedby="global-search-hint"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          maxlength="80"
          placeholder={t(lang, 'search.placeholder')}
          data-i18n-placeholder="search.placeholder"
          class="w-full rounded-2xl border border-cyan-200 bg-white py-4 pl-12 pr-12 text-base text-gray-900 shadow-sm outline-none transition placeholder:text-gray-500 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/40 dark:border-white/15 dark:bg-zinc-900/60 dark:text-white dark:placeholder:text-gray-400"
        />
        <button
          type="button"
          id="global-search-clear"
          hidden
          class="absolute right-3 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full text-gray-600 transition hover:bg-gray-100 focus-visible:ring-2 focus-visible:ring-cyan-500 dark:text-gray-300 dark:hover:bg-white/10"
          aria-label={t(lang, 'search.clear')}
          data-i18n-aria="search.clear"
        >
          <span class="material-symbols-outlined text-xl" aria-hidden="true">close</span>
        </button>
      </div>
      <p id="global-search-hint" class="sr-only" data-i18n="search.hint">{t(lang, 'search.hint')}</p>

      <div id="global-search-suggestions" class="mt-4 flex flex-wrap items-center justify-center gap-2">
        <span class="text-sm text-gray-600 dark:text-gray-400" data-i18n="search.suggestions">{t(lang, 'search.suggestions')}</span>
        {suggestions.map((term) => (
          <button
            type="button"
            data-search-suggestion={term}
            class="rounded-full border border-cyan-200 bg-white px-3 py-1 text-sm text-cyan-800 transition hover:border-cyan-500 focus-visible:ring-2 focus-visible:ring-cyan-500 dark:border-cyan-400/30 dark:bg-zinc-900 dark:text-cyan-300"
          >
            {term}
          </button>
        ))}
      </div>

      <p id="global-search-status" role="status" aria-live="polite" class="mt-4 min-h-6 text-center text-sm text-gray-600 dark:text-gray-400"></p>

      <div id="global-search-results" role="listbox" aria-label={t(lang, 'search.label')} data-i18n-aria="search.label" hidden class="mt-2 space-y-6"></div>

      <div class="mt-4 text-center">
        <button
          type="button"
          id="global-search-more"
          hidden
          class="rounded-full border border-cyan-200 bg-white px-4 py-2 text-sm font-medium text-cyan-800 transition hover:border-cyan-500 focus-visible:ring-2 focus-visible:ring-cyan-500 dark:border-cyan-400/30 dark:bg-zinc-900 dark:text-cyan-300"
        ></button>
      </div>
    </div>
  </div>
</section>

<script>
  import { groupResults, prepare, search } from '../../utils/search';
  import type { PreparedEntry, SearchEntry } from '../../utils/search';

  type Lang = 'es' | 'en';
  const PER_GROUP = 6;

  const root = document.querySelector<HTMLElement>('[data-search-root]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>('#global-search-input')!;
    const clearBtn = root.querySelector<HTMLButtonElement>('#global-search-clear')!;
    const resultsEl = root.querySelector<HTMLElement>('#global-search-results')!;
    const statusEl = root.querySelector<HTMLElement>('#global-search-status')!;
    const moreBtn = root.querySelector<HTMLButtonElement>('#global-search-more')!;
    const suggestionsEl = root.querySelector<HTMLElement>('#global-search-suggestions')!;
    const indexUrl = root.dataset.indexUrl!;

    let prepared: PreparedEntry[] | null = null;
    let loading: Promise<void> | null = null;
    let loadFailed = false;
    let expanded = false;
    let activeIndex = -1;
    let options: HTMLAnchorElement[] = [];

    const getLang = (): Lang => (localStorage.getItem('lang') === 'en' ? 'en' : 'es');
    const ui = (key: string, vars: Record<string, string | number> = {}): string => {
      const dict = (window as unknown as { translations?: Record<Lang, Record<string, string>> }).translations;
      const text = dict?.[getLang()]?.[key] ?? dict?.es?.[key] ?? key;
      return text.replace(/\{(\w+)\}/g, (_, name) => String(vars[name] ?? ''));
    };

    function load(): Promise<void> {
      if (prepared) return Promise.resolve();
      loading ??= fetch(indexUrl)
        .then((response) => {
          if (!response.ok) throw new Error(String(response.status));
          return response.json() as Promise<SearchEntry[]>;
        })
        .then((entries) => {
          prepared = prepare(entries);
          loadFailed = false;
        })
        .catch(() => {
          loadFailed = true;
          loading = null;
        });
      return loading;
    }

    function setActive(index: number) {
      options.forEach((option, i) => {
        const isActive = i === index;
        option.setAttribute('aria-selected', String(isActive));
        option.classList.toggle('ring-2', isActive);
        option.classList.toggle('ring-cyan-500', isActive);
      });
      activeIndex = index;
      const active = options[index];
      if (active) {
        input.setAttribute('aria-activedescendant', active.id);
        active.scrollIntoView({ block: 'nearest' });
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    }

    function clearResults() {
      resultsEl.replaceChildren();
      resultsEl.hidden = true;
      moreBtn.hidden = true;
      options = [];
      input.setAttribute('aria-expanded', 'false');
      setActive(-1);
    }

    function render() {
      const query = input.value.trim();
      clearBtn.hidden = query.length === 0;
      suggestionsEl.hidden = query.length > 0;

      if (!query) {
        statusEl.textContent = '';
        clearResults();
        return;
      }
      if (loadFailed) {
        statusEl.textContent = ui('search.error');
        clearResults();
        return;
      }
      if (!prepared) {
        clearResults();
        return;
      }

      const lang = getLang();
      const results = search(prepared, query);
      if (results.length === 0) {
        statusEl.textContent = ui('search.no_results', { q: query });
        clearResults();
        return;
      }

      statusEl.textContent = results.length === 1 ? ui('search.result_one') : ui('search.result_other', { n: results.length });

      const groups = groupResults(results);
      const hidden = groups.reduce((sum, g) => sum + Math.max(0, g.items.length - PER_GROUP), 0);
      resultsEl.replaceChildren();
      options = [];

      groups.forEach(({ group, items }) => {
        const section = document.createElement('div');
        section.setAttribute('role', 'group');
        const headingId = `search-group-${group}`;
        section.setAttribute('aria-labelledby', headingId);

        const heading = document.createElement('p');
        heading.id = headingId;
        heading.className = 'mb-2 text-xs font-semibold uppercase tracking-wider text-cyan-700 dark:text-cyan-400';
        heading.textContent = ui(`search.group.${group}`);
        section.append(heading);

        const list = document.createElement('div');
        list.className = 'grid grid-cols-1 gap-2 md:grid-cols-2';
        const visible = expanded ? items : items.slice(0, PER_GROUP);
        visible.forEach(({ entry }, position) => {
          const option = document.createElement('a');
          option.id = `search-option-${options.length}`;
          option.setAttribute('role', 'option');
          option.setAttribute('aria-selected', 'false');
          option.href = entry.url;
          option.className =
            'block rounded-xl border border-cyan-100 bg-white p-4 shadow-sm outline-none transition hover:border-cyan-400 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none';
          // Si el número de resultados del grupo es impar, el último ocupa toda la fila
          if (visible.length % 2 === 1 && position === visible.length - 1) {
            option.classList.add('md:col-span-2');
          }

          const top = document.createElement('div');
          top.className = 'flex flex-wrap items-center gap-2';
          const title = document.createElement('span');
          title.className = 'font-semibold text-gray-900 dark:text-white';
          title.textContent = entry.title[lang];
          const badge = document.createElement('span');
          badge.className =
            'rounded-full border border-cyan-200 bg-cyan-50 px-2 py-0.5 text-[10px] font-semibold uppercase text-cyan-800 dark:border-cyan-400/30 dark:bg-cyan-400/10 dark:text-cyan-300';
          badge.textContent = ui(`search.type.${entry.type}`);
          top.append(title, badge);
          if (entry.level) {
            const level = document.createElement('span');
            level.className = 'text-[11px] text-gray-600 dark:text-gray-400';
            level.textContent = `${entry.level}/5`;
            top.append(level);
          }

          const desc = document.createElement('p');
          desc.className = 'mt-1 line-clamp-2 text-sm text-gray-700 dark:text-gray-300';
          desc.textContent = entry.desc[lang];

          option.append(top, desc);
          list.append(option);
          options.push(option);
        });
        section.append(list);
        resultsEl.append(section);
      });

      resultsEl.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      setActive(-1);

      moreBtn.hidden = hidden === 0;
      moreBtn.textContent = expanded ? ui('search.less') : ui('search.more', { n: hidden });
    }

    async function onInput() {
      expanded = false;
      if (input.value.trim() && !prepared) await load();
      render();
    }

    // Llegada desde el icono del header en otra página: enfocar el buscador
    if (window.location.hash === '#buscador') {
      window.setTimeout(() => input.focus({ preventScroll: true }), 400);
    }

    input.addEventListener('focus', () => void load());
    input.addEventListener('input', () => void onInput());
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' && options.length) {
        event.preventDefault();
        setActive((activeIndex + 1) % options.length);
      } else if (event.key === 'ArrowUp' && options.length) {
        event.preventDefault();
        setActive(activeIndex <= 0 ? options.length - 1 : activeIndex - 1);
      } else if (event.key === 'Enter' && options.length) {
        event.preventDefault();
        (options[activeIndex] ?? options[0]).click();
      } else if (event.key === 'Escape') {
        if (input.value) {
          event.preventDefault();
          input.value = '';
          render();
        }
      }
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      render();
      input.focus();
    });
    moreBtn.addEventListener('click', () => {
      expanded = !expanded;
      render();
    });
    suggestionsEl.querySelectorAll<HTMLButtonElement>('[data-search-suggestion]').forEach((button) => {
      button.addEventListener('click', () => {
        input.value = button.dataset.searchSuggestion ?? '';
        input.focus();
        void onInput();
      });
    });
    window.addEventListener('app:languagechange', () => {
      render();
    });

    // aria-label traducibles (language.js solo cambia texto y placeholder)
    const applyAria = () => {
      root.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((el) => {
        el.setAttribute('aria-label', ui(el.dataset.i18nAria!));
      });
    };
    applyAria();
    window.addEventListener('app:languagechange', applyAria);
  }
</script>
