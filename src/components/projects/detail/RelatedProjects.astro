---
import ProjectCard from '../ProjectCard.astro';
import { getDisciplineLabel, getSubjectLabel } from '../../../data/projects';
import { t } from '../../../data/translations';
import type { RelatedProject } from '../../../utils/related-projects';
import type { Language } from '../../../utils/url';
import SectionHeading from './SectionHeading.astro';

interface Props {
  related: RelatedProject[];
  lang: Language;
}

const { related, lang } = Astro.props;

const reasonColorMap = {
  subject: 'border border-purple-400/50 bg-purple-100/20 text-purple-700 dark:border-purple-400/30 dark:bg-purple-500/10 dark:text-purple-300',
  discipline: 'border border-cyan-400/50 bg-cyan-100/20 text-cyan-700 dark:border-cyan-400/30 dark:bg-cyan-500/10 dark:text-cyan-300',
  year: 'border border-amber-400/50 bg-amber-100/20 text-amber-700 dark:border-amber-400/30 dark:bg-amber-500/10 dark:text-amber-300',
  technologies: 'border border-emerald-400/50 bg-emerald-100/20 text-emerald-700 dark:border-emerald-400/30 dark:bg-emerald-500/10 dark:text-emerald-300',
  languages: 'border border-blue-400/50 bg-blue-100/20 text-blue-700 dark:border-blue-400/30 dark:bg-blue-500/10 dark:text-blue-300',
  default: 'border border-gray-400/50 bg-gray-100/20 text-gray-700 dark:border-gray-400/30 dark:bg-gray-500/10 dark:text-gray-300',
};
---

{related.length > 0 && (
  <section class="mb-16">
    <SectionHeading emoji="🔗" titleKey="project.related_title" lang={lang} />
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" style="grid-auto-rows: 1fr;">
      {related.map((item) => (
        <div class="flex flex-col h-full">
          <ProjectCard
            slug={item.project.slug}
            title={item.project.title}
            description={item.project.description}
            coverImage={item.project.cover ?? ''}
            tags={item.project.tags}
            disciplines={item.project.disciplines}
            context={item.project.context}
            academicYear={item.project.academicYear}
            year={item.project.year}
            subjects={item.project.subjects}
            technologies={item.project.technologies?.map((tech) => tech.name) ?? []}
            type={item.project.type}
            lang={lang}
          />
          <div class="mt-2">
            <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ${reasonColorMap[item.reasonType]}`}>
              <span data-i18n={`project.related.${item.reasonType}`}>{t(lang, `project.related.${item.reasonType}`)}</span>
              {item.reasonValue && ': '}
              {item.reasonType === 'discipline' ? (
                <span data-i18n={`discipline.${item.reasonValue}`}>{getDisciplineLabel(item.reasonValue, lang)}</span>
              ) : item.reasonType === 'subject' ? (
                <span data-i18n-es={getSubjectLabel(item.reasonValue, 'es')} data-i18n-en={getSubjectLabel(item.reasonValue, 'en')}>
                  {getSubjectLabel(item.reasonValue, lang)}
                </span>
              ) : (
                item.reasonValue
              )}
            </span>
          </div>
        </div>
      ))}
    </div>
  </section>
)}
