---
import type { ProjectTechnology } from '../../../data/projects';
import { t } from '../../../data/translations';
import type { Language } from '../../../utils/url';

interface Props {
  slug: string;
  role?: string | null;
  team?: string | null;
  duration?: string | null;
  technologies?: ProjectTechnology[];
  lang: Language;
}

const { slug, role, team, duration, technologies = [], lang } = Astro.props;

const facts = [
  { icon: 'person', labelKey: 'project.role_label', valueKey: `project.${slug}.role`, value: role },
  { icon: 'group', labelKey: 'project.team_label', valueKey: `project.${slug}.team`, value: team },
  { icon: 'schedule', labelKey: 'project.duration_label', valueKey: `project.${slug}.duration`, value: duration },
].filter((fact) => Boolean(fact.value));

const levelClasses: Record<string, string> = {
  principal: 'bg-cyan-50 text-cyan-800 dark:bg-cyan-400/10 dark:text-cyan-300 border border-cyan-300 dark:border-cyan-400/30',
  secundaria: 'bg-sky-50 text-sky-800 dark:bg-sky-400/10 dark:text-sky-300 border border-sky-200 dark:border-sky-400/20',
  experimental: 'bg-amber-50 text-amber-800 dark:bg-amber-400/10 dark:text-amber-300 border border-amber-200 dark:border-amber-400/20',
};
---

<div class="space-y-4">
  {facts.map((fact) => (
    <div class="rounded-2xl border border-cyan-100 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
      <div class="flex items-center gap-2 text-cyan-600 dark:text-cyan-400">
        <span class="material-symbols-outlined text-sm">{fact.icon}</span>
        <h3 class="text-sm font-bold uppercase tracking-wider" data-i18n={fact.labelKey}>
          {t(lang, fact.labelKey)}
        </h3>
      </div>
      <p class="mt-2 text-black dark:text-white" data-i18n={fact.valueKey}>
        {fact.value}
      </p>
    </div>
  ))}
</div>

<div class="md:col-span-2">
  {technologies.length > 0 && (
    <div class="rounded-2xl border border-cyan-100 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-zinc-900/40 h-full">
      <div class="flex items-center gap-2 mb-4 text-cyan-600 dark:text-cyan-400">
        <span class="material-symbols-outlined text-sm">code</span>
        <h3 class="text-sm font-bold uppercase tracking-wider" data-i18n="project.technologies_label">
          {t(lang, 'project.technologies_label')}
        </h3>
      </div>
      <div class="flex flex-wrap gap-2">
        {technologies.map((tech) => (
          <span class={`rounded-full px-4 py-2 text-sm font-medium transition-all hover:scale-105 ${levelClasses[tech.level ?? ''] ?? ''}`}>
            {tech.name}
            {tech.level === 'principal' && ' ⭐'}
          </span>
        ))}
      </div>
    </div>
  )}
</div>
