---
import type { ProjectStoryStep } from '../../../data/projects';
import { t } from '../../../data/translations';
import type { Language } from '../../../utils/url';
import SectionHeading from './SectionHeading.astro';

interface Props {
  steps: ProjectStoryStep[];
  lang: Language;
}

const { steps, lang } = Astro.props;

const stepConfig: Record<string, { gradient: string; bg: string; border: string; label: string }> = {
  context: {
    gradient: 'from-blue-500 to-cyan-400',
    bg: 'bg-blue-50/80 dark:bg-blue-950/30',
    border: 'border-blue-200 dark:border-blue-800/30',
    label: 'project.story.context',
  },
  objective: {
    gradient: 'from-amber-500 to-yellow-400',
    bg: 'bg-amber-50 dark:bg-amber-950/20',
    border: 'border-amber-200 dark:border-amber-800/30',
    label: 'project.story.objective',
  },
  implementation: {
    gradient: 'from-emerald-500 to-teal-400',
    bg: 'bg-emerald-50 dark:bg-emerald-950/20',
    border: 'border-emerald-200 dark:border-emerald-800/30',
    label: 'project.story.implementation',
  },
  learning: {
    gradient: 'from-cyan-500 to-sky-400',
    bg: 'bg-cyan-50 dark:bg-cyan-950/20',
    border: 'border-cyan-200 dark:border-cyan-800/30',
    label: 'project.story.learning',
  },
};
---

<SectionHeading emoji="📖" titleKey="project.story_title" subtitleKey="project.story_subtitle" lang={lang} />

<div class="relative">
  <div class="absolute left-0 right-0 top-6 h-0.5 bg-linear-to-r from-sky-400 via-emerald-400 to-amber-400"></div>

  <div class="relative grid grid-cols-1 gap-8 md:grid-cols-4">
    {steps.map((step) => {
      const config = stepConfig[step.kind] || stepConfig.context;
      return (
        <div class="relative flex flex-col items-center">
          <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full bg-cyan-700 text-white shadow-lg shadow-cyan-700/20 transition-transform duration-300 hover:scale-110 dark:bg-cyan-500 dark:text-zinc-950">
            <span class="material-symbols-outlined text-2xl">{step.icon}</span>
          </div>

          <div class={`relative mt-6 w-full rounded-2xl border p-5 transition-all duration-300 hover:shadow-md ${config.bg} ${config.border}`}>
            <div class={`absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-linear-to-r ${config.gradient}`}></div>

            <div class="relative pt-1">
              <p class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400" data-i18n={config.label}>
                {t(lang, config.label)}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-gray-700 dark:text-gray-300" data-i18n-es={step.text.es} data-i18n-en={step.text.en}>
                {lang === 'es' ? step.text.es : step.text.en}
              </p>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</div>
