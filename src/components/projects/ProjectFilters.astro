---
import type { Language } from '../../utils/url';
import { DISCIPLINE_MAP, publicProjects } from '../../data/projects';
import { getDisciplineLabel } from '../../data/projects';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;

const contextMap = {
  grado: { emoji: '🎓', label: lang === 'es' ? 'Grado' : 'Degree' },
  master: { emoji: '🎓', label: lang === 'es' ? 'Máster' : 'Master' },
  personal: { emoji: '✨', label: lang === 'es' ? 'Proyecto personal' : 'Personal project' },
  laboral: { emoji: '💼', label: lang === 'es' ? 'Proyecto laboral' : 'Professional project' },
};

const disciplineList = Object.entries(DISCIPLINE_MAP).map(([id, { emoji }]) => ({
  id,
  label: getDisciplineLabel(id, lang as 'es' | 'en'),
  emoji,
}));

const years = publicProjects.map((project) => project.year);
const minYear = Math.min(...years);
const maxYear = Math.max(...years);

const buildFilter = (group: string, id: string, label: string, emoji: string) => ({ group, id, label, emoji });
const contextFilters = Object.entries(contextMap).map(([id, info]) => buildFilter('context', id, info.label, info.emoji));
---

<div class="space-y-4">
  <section class="rounded-2xl border border-cyan-100 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-zinc-900/50 dark:shadow-none">
    <div class="mb-3 flex items-center justify-between gap-2">
      <h3 class="text-sm font-bold uppercase tracking-[0.2em] text-cyan-600 dark:text-cyan-400" data-i18n="filter.context">
        {lang === 'es' ? 'Contexto' : 'Context'}
      </h3>
      <button
        id="clear-filters"
        class="shrink-0 text-xs font-semibold text-red-500 transition hover:text-red-600 dark:text-red-400 dark:hover:text-red-300"
        data-i18n="filter.clear"
      >
        {lang === 'es' ? 'Limpiar' : 'Clear'}
      </button>
    </div>
    <div class="space-y-2">
      {contextFilters.map((filter) => (
        <button
          class="filter-btn flex w-full items-center justify-between gap-2 rounded-xl border border-cyan-100 bg-white px-3 py-2.5 text-left text-sm font-medium transition-all duration-200 hover:border-cyan-400 hover:bg-cyan-50 dark:border-white/10 dark:bg-zinc-900/60 dark:text-gray-300 dark:hover:border-cyan-400 dark:hover:bg-cyan-500/10"
          data-filter-group={filter.group}
          data-filter-id={filter.id}
          data-active="false"
          aria-pressed="false"
        >
          <span class="flex items-center gap-2"><span>{filter.emoji}</span><span>{filter.label}</span></span>
          <span class="filter-indicator text-[10px] uppercase tracking-wide text-gray-400">+</span>
        </button>
      ))}
    </div>
  </section>

  <section class="rounded-2xl border border-cyan-100 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-zinc-900/50 dark:shadow-none">
    <h3 class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-cyan-600 dark:text-cyan-400" data-i18n="filter.date_range">
      {lang === 'es' ? 'Rango de fechas' : 'Date range'}
    </h3>
    <div class="space-y-4">
      <label class="block text-xs font-semibold text-black/60 dark:text-gray-300">
        <span class="mb-1 block">{lang === 'es' ? 'Año mínimo' : 'Minimum year'}</span>
        <input
          id="project-year-min"
          type="range"
          min={minYear}
          max={maxYear}
          value={minYear}
          class="w-full accent-cyan-600"
        />
        <span id="project-year-min-value" class="mt-1 block text-sm font-bold text-cyan-700 dark:text-cyan-300">{minYear}</span>
      </label>
      <label class="block text-xs font-semibold text-black/60 dark:text-gray-300">
        <span class="mb-1 block">{lang === 'es' ? 'Año máximo' : 'Maximum year'}</span>
        <input
          id="project-year-max"
          type="range"
          min={minYear}
          max={maxYear}
          value={maxYear}
          class="w-full accent-cyan-600"
        />
        <span id="project-year-max-value" class="mt-1 block text-sm font-bold text-cyan-700 dark:text-cyan-300">{maxYear}</span>
      </label>
    </div>
  </section>

  <section class="rounded-2xl border border-cyan-100 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-zinc-900/50 dark:shadow-none">
    <h3 class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-cyan-600 dark:text-cyan-400" data-i18n="filter.discipline">
      {lang === 'es' ? 'Disciplina' : 'Discipline'}
    </h3>
    <div class="grid grid-cols-1 gap-2">
      {disciplineList.map((filter) => (
        <button
          class:list={[
            'filter-btn flex items-center justify-between gap-2 rounded-xl border px-3 py-2.5 text-left text-sm font-medium transition-all duration-200 cursor-pointer',
            'border-cyan-100 bg-white text-black hover:border-cyan-400 hover:bg-cyan-50 dark:border-white/10 dark:bg-zinc-900/60 dark:text-gray-300 dark:hover:border-cyan-400 dark:hover:bg-cyan-500/10',
          ]}
          data-filter-group="discipline"
          data-filter-id={filter.id}
          data-active="false"
          aria-pressed="false"
        >
          <span class="flex items-center gap-2">
            <span>{filter.emoji}</span>
            <span data-i18n={`discipline.${filter.id}`}>{filter.label}</span>
          </span>
          <span class="filter-indicator text-[10px] uppercase tracking-wide text-gray-400">+</span>
        </button>
      ))}
    </div>
  </section>
</div>

<style>
  .filter-btn[data-active="true"] {
    background: linear-gradient(to right, #00dbe7, #b600f8) !important;
    color: white !important;
    border-color: transparent !important;
  }

  .filter-btn[data-active="true"] .filter-indicator {
    color: white !important;
  }
</style>