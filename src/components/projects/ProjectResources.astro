---
// src/components/projects/ProjectResources.astro
// Recursos y enlaces opcionales de un proyecto (GitHub, itch.io, PDF,
// documentación, demo, Figma, web...). Nunca imágenes/vídeos de galería:
// esos van en ProjectGallery o en el contenido principal.
import type { GalleryItem } from '../../data/projects';
import { t } from '../../data/translations';
import { getProjectLinkTranslationKey } from '../../data/projects';
import type { Language } from '../../utils/url';
import { withBasePath } from '../../utils/paths';
import { resolveEmbed, applyDisplayOverride, type ResolvedMediaKind } from '../../utils/media';

interface Props {
  resources?: GalleryItem[];
  lang?: Language;
}

const { resources = [], lang = 'es' } = Astro.props;

type Card = {
  kind: ResolvedMediaKind | 'pdf' | 'audio';
  label: string;
  url: string;
  embedUrl?: string;
};

function toCard(item: GalleryItem): Card | null {
  const rawUrl = item.url || item.src;
  if (!rawUrl) return null;
  // withBasePath es un no-op para URLs externas; solo prefija rutas locales
  // (p.ej. un PDF o vídeo guardado en /public), así que es seguro aplicarlo
  // siempre antes de clasificar la URL.
  const url = withBasePath(rawUrl);
  const label = item.title || rawUrl;

  // Tipos ya explícitos en el dato: se respetan directamente.
  if (item.type === 'pdf') return { kind: 'pdf', label, url, embedUrl: item.display === 'link' ? undefined : url };
  if (item.type === 'audio') return { kind: 'audio', label, url };
  if (item.type === 'video') {
    const resolved = applyDisplayOverride(resolveEmbed(url, { declaredType: 'video', label }), item.display);
    return { kind: 'video', label, url, embedUrl: resolved.embedUrl };
  }
  if (item.type === 'game') {
    const resolved = applyDisplayOverride({ kind: 'game', embedUrl: item.display === 'embed' ? url : undefined }, item.display);
    return { kind: 'game', label, url, embedUrl: resolved.embedUrl };
  }
  if (item.type === 'iframe') {
    const resolved = applyDisplayOverride({ kind: 'website', embedUrl: url }, item.display);
    return { kind: 'website', label, url, embedUrl: resolved.embedUrl };
  }

  // Tipo 'link' (o cualquier otro genérico): se infiere por la URL.
  const resolved = applyDisplayOverride(resolveEmbed(url, { label }), item.display);
  return { kind: resolved.kind, label, url, embedUrl: resolved.embedUrl };
}

const cards: Card[] = resources.map(toCard).filter((c): c is Card => c !== null);

const kindConfig: Record<Card['kind'], { icon: string; labelKey: string }> = {
  video: { icon: 'play_circle', labelKey: 'project.resources.video' },
  pdf: { icon: 'picture_as_pdf', labelKey: 'project.resources.pdf' },
  audio: { icon: 'volume_up', labelKey: 'project.resources.audio' },
  figma: { icon: 'draft', labelKey: 'project.resources.prototype' },
  game: { icon: 'sports_esports', labelKey: 'project.resources.play' },
  github: { icon: 'code', labelKey: 'project.resources.github' },
  website: { icon: 'public', labelKey: 'project.resources.website' },
};
---

{cards.length > 0 && (
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    {cards.map((card) => {
      const config = kindConfig[card.kind];
      const linkKey = getProjectLinkTranslationKey(card.label);
      const displayLabel = linkKey ? t(lang, linkKey) : card.label;
      return (
        <div class="overflow-hidden rounded-2xl border border-cyan-100 bg-white shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
          <div class="flex items-center gap-2 border-b border-cyan-100 bg-cyan-50/60 px-4 py-3 dark:border-white/10 dark:bg-cyan-500/10">
            <span class="material-symbols-outlined text-cyan-700 dark:text-cyan-300">{config.icon}</span>
            <span class="text-sm font-semibold text-cyan-900 dark:text-cyan-200" data-i18n={linkKey}>
              {displayLabel}
            </span>
          </div>

          {card.kind === 'video' && card.embedUrl && (
            <div class="aspect-video w-full">
              <iframe
                src={card.embedUrl}
                title={displayLabel}
                class="h-full w-full border-0"
                loading="lazy"
                referrerpolicy="no-referrer"
                sandbox="allow-scripts allow-same-origin allow-popups allow-presentation"
                allow="encrypted-media; picture-in-picture"
              />
            </div>
          )}

          {card.kind === 'audio' && (
            <div class="p-4">
              <audio src={card.url} controls class="w-full" />
            </div>
          )}

          {(card.kind === 'pdf' || card.kind === 'figma' || (card.kind === 'website' && card.embedUrl)) && card.embedUrl && (
            <div class="aspect-[4/3] w-full">
              <iframe
                src={card.embedUrl}
                title={displayLabel}
                class="h-full w-full border-0"
                loading="lazy"
                referrerpolicy="no-referrer"
                sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
              />
            </div>
          )}

          {(card.kind === 'game' || card.kind === 'github' || (card.kind === 'website' && !card.embedUrl) || (card.kind === 'pdf' && !card.embedUrl)) && (
            <div class="p-4">
              <p class="text-sm text-gray-500 dark:text-gray-400" data-i18n="project.resources.open_external">
                {t(lang, 'project.resources.open_external')}
              </p>
            </div>
          )}

          {card.kind !== 'audio' && (
            <div class="flex justify-end border-t border-cyan-50 px-4 py-2 dark:border-white/5">
              <a href={card.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs font-semibold text-cyan-700 hover:text-cyan-900 dark:text-cyan-300 dark:hover:text-cyan-100">
                <span class="material-symbols-outlined text-sm">open_in_new</span>
                <span data-i18n="project.resources.open_external">{t(lang, 'project.resources.open_external')}</span>
              </a>
            </div>
          )}
        </div>
      );
    })}
  </div>
)}
