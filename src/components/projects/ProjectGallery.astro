---
import type { GalleryItem } from '../../data/projects';

interface GalleryImage {
  src: string;
  rotate?: 90 | 180 | 270;
}

interface Props {
  items?: GalleryItem[];
  images?: (string | GalleryImage)[];
  alt?: string;
  altTranslationKey?: string;
  config?: {
    columns?: 1 | 2 | 3 | 4 | 5;
    gap?: 'small' | 'medium' | 'large';
    layout?: 'masonry' | 'grid' | 'featured';
  };
}

const { items = [], images = [], alt = 'Imagen del proyecto', altTranslationKey = 'project.gallery.image', config = {} } = Astro.props;
const normalizeImage = (item: string | GalleryImage): GalleryItem => ({ type: 'image', src: typeof item === 'string' ? item : item.src });
const galleryItems: GalleryItem[] = items.length > 0
  ? items
  : images.map(normalizeImage);

const imageItems = galleryItems.filter((item): item is GalleryItem & { type: 'image'; src: string } => item.type === 'image' && Boolean(item.src));

type GapSize = 'small' | 'medium' | 'large';
type ColumnCount = 1 | 2 | 3 | 4 | 5;

const defaultConfig = {
  columns: 3 as ColumnCount,
  gap: 'medium' as GapSize,
  layout: 'masonry' as 'masonry' | 'grid' | 'featured',
};

const finalConfig = {
  columns: (config.columns || defaultConfig.columns) as ColumnCount,
  gap: (config.gap || defaultConfig.gap) as GapSize,
  layout: (config.layout || defaultConfig.layout) as 'masonry' | 'grid' | 'featured',
};

const gapClasses: Record<GapSize, string> = {
  small: 'gap-2 md:gap-3',
  medium: 'gap-4 md:gap-6',
  large: 'gap-6 md:gap-8',
};
---

<div class="project-gallery" id="gallery-{Math.random().toString(36).slice(2, 7)}">
  {finalConfig.layout === 'masonry' && (
    <div class={`columns-${finalConfig.columns} ${gapClasses[finalConfig.gap]} space-y-4`}>
      {galleryItems.map((item, index) => (
        <div class="break-inside-avoid overflow-hidden rounded-2xl bg-white dark:bg-zinc-800 shadow-sm hover:shadow-md transition-shadow">
          {item.type === 'image' && item.src && (
            <img src={item.src} alt={item.alt || `${alt} ${index + 1}`} data-i18n-alt-key={altTranslationKey} data-i18n-alt-suffix={index + 1} class="w-full h-auto object-contain cursor-pointer transition duration-500 group-hover:scale-[1.02]" loading="lazy" data-fullsrc={item.src} onclick="openLightbox(this)" />
          )}
          {item.type === 'video' && item.src && (
            <video src={item.src} controls class="w-full" preload="metadata" />
          )}
          {item.type === 'audio' && item.src && (
            <audio src={item.src} controls class="w-full" />
          )}
          {item.type === 'pdf' && item.src && (
            <a href={item.src} target="_blank" rel="noopener noreferrer" class="block rounded-xl border border-cyan-200 bg-cyan-50 p-6 text-center font-semibold text-cyan-800 dark:border-cyan-500/30 dark:bg-cyan-500/10 dark:text-cyan-300">📄 {item.title || 'Abrir PDF'}</a>
          )}
          {item.type === 'iframe' && item.src && <iframe src={item.src} title={item.title || 'Contenido incrustado'} class="min-h-80 w-full border-0" loading="lazy" />}
          {item.type === 'game' && item.src && <iframe src={item.src} title={item.title || 'Juego web'} class="min-h-96 w-full border-0" loading="lazy" />}
          {item.type === 'link' && item.url && <a href={item.url} target="_blank" rel="noopener noreferrer" class="block rounded-xl border border-cyan-200 bg-white p-6 text-center font-semibold text-cyan-700 hover:bg-cyan-50 dark:border-white/10 dark:bg-zinc-900/50 dark:text-cyan-300">🔗 {item.title || item.url}</a>}
          {item.title && item.type !== 'image' && <p class="px-4 py-3 text-sm text-gray-700 dark:text-gray-300">{item.title}</p>}
        </div>
      ))}
    </div>
  )}
</div>

{imageItems.length > 0 && (
  <div id="lightbox" class="fixed inset-0 z-9999 hidden items-center justify-center bg-black/95 backdrop-blur-sm" onclick="closeLightbox()">
    <button class="absolute top-4 right-4 z-10000 text-white text-4xl hover:text-cyan-300 transition-colors" onclick="closeLightbox()">✕</button>
    <button class="absolute left-4 z-10000 text-white text-5xl hover:text-cyan-300 transition-colors" onclick="prevImage(event)" id="lightbox-prev">‹</button>
    <button class="absolute right-4 z-10000 text-white text-5xl hover:text-cyan-300 transition-colors" onclick="nextImage(event)" id="lightbox-next">›</button>
    <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain rounded-lg" />
    <span id="lightbox-counter" class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/70 text-sm font-medium"></span>
  </div>
)}

<script>
  let currentImages: string[] = [];
  let currentGalleryImages: HTMLImageElement[] = [];
  let currentIndex = 0;
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxCounter = document.getElementById('lightbox-counter');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  function openLightbox(element: HTMLElement) {
    const gallery = element.closest('.project-gallery');
    const imageElement = element as HTMLImageElement;
    if (!gallery || !lightboxImg) return;
    const allImages = gallery.querySelectorAll('img[data-fullsrc]');
    currentImages = Array.from(allImages).map((el) => el.getAttribute('data-fullsrc') || el.getAttribute('src') || '');
    currentGalleryImages = Array.from(allImages) as HTMLImageElement[];
    currentIndex = currentImages.indexOf(imageElement.getAttribute('data-fullsrc') || imageElement.src);
    if (currentIndex === -1) currentIndex = 0;
    showImage(currentIndex);
    lightbox?.classList.remove('hidden');
    lightbox?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function showImage(index: number) {
    if (!lightboxImg || !lightboxCounter) return;
    const currentImage = currentGalleryImages[index];
    lightboxImg.src = currentImages[index] || '';
    lightboxImg.alt = currentImage?.alt || '';
    lightboxCounter.textContent = `${index + 1} / ${currentImages.length}`;
    if (prevBtn) prevBtn.style.display = currentImages.length > 1 ? 'block' : 'none';
    if (nextBtn) nextBtn.style.display = currentImages.length > 1 ? 'block' : 'none';
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function prevImage(event: Event) {
    event.stopPropagation();
    if (currentImages.length === 0) return;
    currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
    showImage(currentIndex);
  }

  function nextImage(event: Event) {
    event.stopPropagation();
    if (currentImages.length === 0) return;
    currentIndex = (currentIndex + 1) % currentImages.length;
    showImage(currentIndex);
  }

  window.addEventListener('app:languagechange', () => {
    if (!lightbox || lightbox.classList.contains('hidden') || !lightboxImg) return;
    lightboxImg.alt = currentGalleryImages[currentIndex]?.alt || '';
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') { e.preventDefault(); prevImage(e); }
    if (e.key === 'ArrowRight') { e.preventDefault(); nextImage(e); }
  });

  (window as any).openLightbox = openLightbox;
  (window as any).closeLightbox = closeLightbox;
  (window as any).prevImage = prevImage;
  (window as any).nextImage = nextImage;
</script>

<style>
  .project-gallery img, .project-gallery video, .project-gallery audio { display: block; width: 100%; }
  .project-gallery > div > div { overflow: hidden; border-radius: 1rem; background: #ffffff; }
  html.dark .project-gallery > div > div { background: rgb(30 41 59); }
  .columns-1 { column-count: 1; }
  .columns-2 { column-count: 2; }
  .columns-3 { column-count: 3; }
  .columns-4 { column-count: 4; }
  .columns-5 { column-count: 5; }
  .columns-1 .break-inside-avoid { margin-bottom: 0.5rem; }
  .columns-2 .break-inside-avoid { margin-bottom: 0.75rem; }
  .columns-3 .break-inside-avoid { margin-bottom: 1rem; }
  .columns-4 .break-inside-avoid { margin-bottom: 1.25rem; }
  .columns-5 .break-inside-avoid { margin-bottom: 1.5rem; }
  @media (max-width: 640px) { .columns-2, .columns-3, .columns-4, .columns-5 { column-count: 2; } .columns-2 .break-inside-avoid, .columns-3 .break-inside-avoid, .columns-4 .break-inside-avoid, .columns-5 .break-inside-avoid { margin-bottom: 0.5rem; } }
  #lightbox { transition: opacity 0.3s ease; }
  #lightbox.hidden { opacity: 0; pointer-events: none; }
  #lightbox:not(.hidden) { opacity: 1; pointer-events: auto; }
</style>