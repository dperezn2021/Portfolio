---
---

<div class="glass-card rounded-2xl border border-cyan-100 bg-white p-8 shadow-sm dark:border-white/10 dark:bg-zinc-900/60 dark:shadow-none">
  <h3 class="font-grotesk text-2xl font-bold text-black dark:text-white" data-i18n="contact.form_title">
    Envíame un mensaje
  </h3>

  <form id="contact-form" class="mt-6 space-y-4" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="block text-sm font-medium text-black dark:text-gray-300" data-i18n="contact.form_name">
          Nombre
        </label>
        <input type="text" name="name" required class="mt-1 w-full rounded-xl border border-cyan-100 bg-white px-4 py-3 text-black outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 dark:border-white/10 dark:bg-zinc-900/50 dark:text-white" placeholder="Tu nombre" data-i18n-placeholder="contact.form_name_placeholder" />
      </div>
      <div>
        <label class="block text-sm font-medium text-black dark:text-gray-300" data-i18n="contact.form_email">
          Email
        </label>
        <input type="email" name="email" required class="mt-1 w-full rounded-xl border border-cyan-100 bg-white px-4 py-3 text-black outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 dark:border-white/10 dark:bg-zinc-900/50 dark:text-white" placeholder="tucorreo@email.com" data-i18n-placeholder="contact.form_email_placeholder" />
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-black dark:text-gray-300" data-i18n="contact.form_subject">
        Asunto
      </label>
      <input type="text" name="subject" class="mt-1 w-full rounded-xl border border-cyan-100 bg-white px-4 py-3 text-black outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 dark:border-white/10 dark:bg-zinc-900/50 dark:text-white" placeholder="¿Sobre qué quieres hablar?" data-i18n-placeholder="contact.form_subject_placeholder" />
    </div>

    <div>
      <label class="block text-sm font-medium text-black dark:text-gray-300" data-i18n="contact.form_message">
        Mensaje
      </label>
      <textarea rows="5" name="message" required class="mt-1 w-full resize-none rounded-xl border border-cyan-100 bg-white px-4 py-3 text-black outline-none transition focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 dark:border-white/10 dark:bg-zinc-900/50 dark:text-white" placeholder="Cuéntame sobre tu proyecto..." data-i18n-placeholder="contact.form_message_placeholder"></textarea>
    </div>

    <button type="submit" class="btn-primary w-full">
      <span class="material-symbols-outlined text-sm">send</span>
      <span data-i18n="contact.form_submit">Enviar Mensaje</span>
    </button>
  </form>
</div>