---
import { site } from '../../data/settings';
import { socials } from '../../data/socials';
---

<div class="space-y-6">
  <!-- Email -->
  <div class="glass-card rounded-2xl border border-cyan-100 bg-white p-6 shadow-sm flex items-center gap-4 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
    <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-cyan-400/10 text-cyan-600 dark:bg-cyan-400/10 dark:text-cyan-400">
      <span class="material-symbols-outlined">alternate_email</span>
    </div>
    <div>
      <!-- ✅ ELIMINADO dark:text-black -->
      <p class="text-xs font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400" data-i18n="contact.email_label">
        Email
      </p>
      <a href={`mailto:${site.email}`} class="font-semibold text-gray-900 transition hover:text-cyan-600 dark:text-white dark:hover:text-cyan-400">
        {site.email}
      </a>
    </div>
  </div>

  <!-- Redes Sociales -->
  <div class="glass-card rounded-2xl border border-cyan-100 bg-white p-6 shadow-sm flex items-center gap-4 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
    <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-fuchsia-500/10 text-fuchsia-500 dark:bg-fuchsia-500/10 dark:text-fuchsia-400">
      <span class="material-symbols-outlined">hub</span>
    </div>
    <div>
      <!-- ✅ ELIMINADO dark:text-black -->
      <p class="text-xs font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400" data-i18n="contact.social_label">
        Redes Sociales
      </p>
      <div class="flex flex-wrap gap-3 mt-1">
        {socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-gray-900 transition hover:text-cyan-600 dark:text-gray-300 dark:hover:text-cyan-400"
          >
            {social.name}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Ubicación -->
  <div class="glass-card rounded-2xl border border-cyan-100 bg-white p-6 shadow-sm flex items-center gap-4 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
    <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-purple-500/10 text-purple-500 dark:bg-purple-500/10 dark:text-purple-400">
      <span class="material-symbols-outlined">location_on</span>
    </div>
    <div>
      <!-- ✅ ELIMINADO dark:text-black -->
      <p class="text-xs font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400" data-i18n="contact.location_label">
        Ubicación
      </p>
      <p class="font-semibold text-gray-900 dark:text-white">{site.location}</p>
    </div>
  </div>
</div>