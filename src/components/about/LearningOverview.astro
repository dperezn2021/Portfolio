---
import { credentials, pendingCredentials, shortCourses, skillsInventory } from '../../data/learning';
import type { Language } from '../../utils/url';
import { t } from '../../data/translations';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';

// Categorías con sus claves de traducción
const categories = [
  { key: 'game_development', label: 'Desarrollo de Videojuegos' },
  { key: 'web_development', label: 'Desarrollo Web' },
  { key: 'design', label: 'Diseño' },
  { key: 'programming', label: 'Programación' },
  { key: 'databases', label: 'Bases de Datos' },
  { key: 'cloud', label: 'Cloud' },
  { key: 'devops', label: 'DevOps' },
  { key: 'observability', label: 'Observabilidad' },
  { key: 'streaming', label: 'Streaming' },
  { key: 'support', label: 'Soporte' },
  { key: 'ai', label: 'Inteligencia Artificial' },
  { key: 'tools', label: 'Herramientas' },
];

const getCategoryIcon = (categoryKey: string): string => {
  const icons: Record<string, string> = {
    'game_development': 'sports_esports',
    'web_development': 'code',
    'design': 'brush',
    'programming': 'terminal',
    'databases': 'database',
    'cloud': 'cloud',
    'devops': 'settings',
    'observability': 'monitoring',
    'streaming': 'play_arrow',
    'support': 'support_agent',
    'ai': 'neurology',
    'tools': 'build',
  };
  return icons[categoryKey] || 'circle';
};

const getSourceColor = (source: string): string => {
  const colors: Record<string, string> = {
    'Universidad': 'bg-purple-100 text-purple-700 dark:bg-purple-500/20 dark:text-purple-300',
    'Trabajo': 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-300',
    'Personal': 'bg-blue-100 text-blue-700 dark:bg-blue-500/20 dark:text-blue-300',
  };
  return colors[source] || 'bg-gray-100 text-gray-700 dark:bg-gray-500/20 dark:text-gray-300';
};

const getLegendColor = (source: string): string => {
  const colors: Record<string, string> = {
    'Universidad': 'bg-purple-500',
    'Trabajo': 'bg-emerald-500',
    'Personal': 'bg-blue-500',
  };
  return colors[source] || 'bg-gray-500';
};

const legendItems = [
  { key: 'Universidad', label: 'about.learning.tag_university' },
  { key: 'Trabajo', label: 'about.learning.tag_work' },
  { key: 'Personal', label: 'about.learning.tag_personal' },
];
---

<section class="py-16 transition-colors duration-300 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <h2 class="section-title text-center" data-i18n="about.learning_title">
      {t(lang, 'about.learning_title')}
    </h2>
    <p class="section-subtitle text-center" data-i18n="about.learning_subtitle">
      {t(lang, 'about.learning_subtitle')}
    </p>

    <!-- MÉTRICAS -->
    <div class="mt-10 grid grid-cols-3 gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-cyan-100 bg-white p-5 text-center shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
        <p class="text-xs font-semibold uppercase tracking-wider text-cyan-600 dark:text-cyan-400" data-i18n="about.learning.metric_credentials">
          {t(lang, 'about.learning.metric_credentials')}
        </p>
        <p class="mt-1 text-3xl font-bold text-black dark:text-white">{credentials.length + shortCourses.length + pendingCredentials.length}</p>
      </div>
      <div class="rounded-2xl border border-cyan-100 bg-white p-5 text-center shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
        <p class="text-xs font-semibold uppercase tracking-wider text-cyan-600 dark:text-cyan-400" data-i18n="about.learning.metric_skills">
          {t(lang, 'about.learning.metric_skills')}
        </p>
        <p class="mt-1 text-3xl font-bold text-black dark:text-white">{skillsInventory.length}</p>
      </div>
      <div class="rounded-2xl border border-cyan-100 bg-white p-5 text-center shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
        <p class="text-xs font-semibold uppercase tracking-wider text-cyan-600 dark:text-cyan-400" data-i18n="about.learning.metric_categories">
          {t(lang, 'about.learning.metric_categories')}
        </p>
        <p class="mt-1 text-3xl font-bold text-black dark:text-white">{categories.length}</p>
      </div>
     
    </div>

    <!-- LEYENDA -->
    <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-sm">
      {legendItems.map((item) => (
        <span class="flex items-center gap-2">
          <span class={`inline-block h-3 w-3 rounded-full ${getLegendColor(item.key)}`}></span>
          <span data-i18n={item.label}>{t(lang, item.label)}</span>
        </span>
      ))}
    </div>

    <!-- CERTIFICACIONES -->
    <div class="mt-8 rounded-2xl border border-cyan-100 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
      <h3 class="font-grotesk text-xl font-bold text-black dark:text-white" data-i18n="about.learning.credentials_title">
        {t(lang, 'about.learning.credentials_title')}
      </h3>
      <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
        {credentials.map((cred) => (
          <div class="flex items-start gap-4 rounded-xl border border-cyan-100 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-zinc-900/50">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cyan-100 text-cyan-600 dark:bg-cyan-400/10 dark:text-cyan-400">
              <span class="material-symbols-outlined text-2xl">{cred.icon || 'school'}</span>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase text-cyan-600 dark:text-cyan-400" data-i18n={`credential.type.${cred.type}`}>
                {t(lang, `credential.type.${cred.type}`)}
              </p>
              <h4 class="font-semibold text-black dark:text-white" data-i18n={`credential.${cred.id}.title`}>
                {t(lang, `credential.${cred.id}.title`)}
              </h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">{cred.issuer}</p>
              <p class="text-xs text-gray-500 dark:text-gray-500">{cred.year}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-6 rounded-2xl border border-cyan-100 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
      <h3 class="font-grotesk text-xl font-bold text-black dark:text-white" data-i18n="about.learning.short_courses_title">
        {t(lang, 'about.learning.short_courses_title')}
      </h3>
      <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
        {shortCourses.map((cred) => (
          <article class="flex items-start gap-3 rounded-xl border border-cyan-100 bg-white p-4 dark:border-white/10 dark:bg-zinc-900/50">
            <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">{cred.icon || 'school'}</span>
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase text-cyan-600 dark:text-cyan-400" data-i18n={`credential.type.${cred.type}`}>
                {t(lang, `credential.type.${cred.type}`)}
              </p>
              <h4 class="font-semibold text-black dark:text-white" data-i18n={`credential.${cred.id}.title`}>
                {t(lang, `credential.${cred.id}.title`)}
              </h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                {cred.issuer}{cred.year && ` · ${lang === 'es' ? cred.year : cred.year.replace('Ago.', 'Aug.')}`}{cred.credentialId && ` · ID: ${cred.credentialId}`}
                {cred.pending && <span data-i18n="about.learning.pending"> · {t(lang, 'about.learning.pending')}</span>}
              </p>
              {cred.url && (
                <a class="mt-1 inline-block text-sm font-medium text-cyan-700 underline hover:text-cyan-600 dark:text-cyan-300" href={cred.url} target="_blank" rel="noreferrer" data-i18n="about.learning.view_credential">
                  {t(lang, 'about.learning.view_credential')}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    {pendingCredentials.length > 0 && (
      <section class="mt-6 rounded-2xl border border-red-300 bg-transparent p-6 dark:border-red-400/40">
        <h3 class="font-grotesk text-xl font-bold text-red-800 dark:text-red-200" data-i18n="about.learning.pending_title">
          {t(lang, 'about.learning.pending_title')}
        </h3>
        <div class="mt-4 space-y-3">
          {pendingCredentials.map((cred) => (
            <article class="flex items-start gap-3 rounded-xl border border-red-200 bg-transparent p-4 dark:border-red-400/30">
              <span class="material-symbols-outlined text-red-600 dark:text-red-300">{cred.icon || 'pending_actions'}</span>
              <div>
                <p class="text-xs font-semibold uppercase text-red-700 dark:text-red-300" data-i18n={`credential.type.${cred.type}`}>
                  {t(lang, `credential.type.${cred.type}`)}
                </p>
                <h4 class="font-semibold text-black dark:text-white" data-i18n={`credential.${cred.id}.title`}>
                  {t(lang, `credential.${cred.id}.title`)}
                </h4>
                <p class="text-sm text-gray-700 dark:text-gray-300">{cred.issuer}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- INVENTARIO DE HABILIDADES -->
    <div class="mt-8 rounded-2xl border border-cyan-100 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
      <div class="flex items-center justify-between">
        <h3 class="font-grotesk text-xl font-bold text-black dark:text-white" data-i18n="about.learning.skills_title">
          {t(lang, 'about.learning.skills_title')}
        </h3>
        <span class="text-sm text-gray-500 dark:text-gray-400">
          {skillsInventory.length} <span data-i18n="about.learning.skills_count">{t(lang, 'about.learning.skills_count')}</span>
        </span>
      </div>

      {categories.map((cat) => {
        const skills = skillsInventory.filter(s => s.category === cat.key);
        if (skills.length === 0) return null;

        return (
          <details class="mt-4 rounded-xl border border-cyan-100 bg-white p-4 dark:border-white/10 dark:bg-zinc-900/50">
            <summary class="flex cursor-pointer list-none items-center gap-2">
              <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">
                {getCategoryIcon(cat.key)}
              </span>
              <h4 class="font-semibold text-black dark:text-white" data-i18n={`category.${cat.key}`}>
                {t(lang, `category.${cat.key}`)}
              </h4>
              <span class="text-xs text-gray-500 dark:text-gray-400">({skills.length})</span>
              <span class="ml-auto material-symbols-outlined text-gray-500 dark:text-gray-400">expand_more</span>
            </summary>
            <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 md:grid-cols-3">
              {skills.map((skill) => (
                <div class="rounded-lg border border-cyan-100/60 bg-white p-3 shadow-sm dark:border-white/10 dark:bg-zinc-900/30">
                  <div class="flex items-start justify-between">
                    <span class="text-sm font-medium text-black dark:text-white" data-i18n={`skill.${skill.id}`}>
                      {t(lang, `skill.${skill.id}`)}
                    </span>
                    {skill.level && (
                      <span class="rounded-full bg-cyan-100 px-2 py-0.5 text-xs font-bold text-cyan-700 dark:bg-cyan-400/10 dark:text-cyan-300">
                        {skill.level}/5
                      </span>
                    )}
                  </div>
                  <div class="mt-1 flex flex-wrap gap-1">
                    {skill.sources.map((source) => {
                      const labelKey = source === 'Universidad' ? 'about.learning.tag_university' : source === 'Trabajo' ? 'about.learning.tag_work' : 'about.learning.tag_personal';
                      return (
                        <span class={`rounded-full px-2 py-0.5 text-[10px] font-medium ${getSourceColor(source)}`}>
                          <span data-i18n={labelKey}>{t(lang, labelKey)}</span>
                        </span>
                      );
                    })}
                  </div>
                  <p class="mt-1 text-xs text-gray-500 dark:text-gray-400 line-clamp-2" data-i18n={`skill.${skill.id}.desc`}>
                    {t(lang, `skill.${skill.id}.desc`)}
                  </p>
                </div>
              ))}
            </div>
          </details>
        );
      })}
    </div>
  </div>
</section>