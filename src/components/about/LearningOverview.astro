---
import { credentials, pendingCredentials, shortCourses, currentLearning } from '../../data/learning';
import type { Language } from '../../utils/url';
import { t } from '../../data/translations';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
---

<section class="py-16 transition-colors duration-300 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <h2 class="section-title text-center" data-i18n="about.learning_title">
      {t(lang, 'about.learning_title')}
    </h2>
    <p class="section-subtitle text-center" data-i18n="about.learning_subtitle">
      {t(lang, 'about.learning_subtitle')}
    </p>

    <!-- TITULACIONES OFICIALES -->
    <div class="mt-10 rounded-2xl border border-cyan-100 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
      <h3 class="font-grotesk text-xl font-bold text-black dark:text-white" data-i18n="about.learning.credentials_title">
        {t(lang, 'about.learning.credentials_title')}
      </h3>
      
      <div class="mt-4 grid gap-4" style={`grid-template-columns: repeat(${credentials.length === 1 ? 1 : 2}, minmax(0, 1fr))`}>
        
        {credentials.map((cred) => (
          <div id={`cred-${cred.id}`} tabindex="-1" class="flex scroll-mt-28 items-start gap-4 rounded-xl border border-cyan-100 bg-white p-4 shadow-sm outline-none dark:border-white/10 dark:bg-zinc-900/50">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cyan-100 text-cyan-600 dark:bg-cyan-400/10 dark:text-cyan-400">
              <span class="material-symbols-outlined text-2xl">{cred.icon || 'school'}</span>
            </div>
            
            <div>
              <p class="text-xs font-semibold uppercase text-cyan-600 dark:text-cyan-400" data-i18n={`credential.type.${cred.type}`}>
                {t(lang, `credential.type.${cred.type}`)}
              </p>
              <h4 class="font-semibold text-black dark:text-white" data-i18n={`credential.${cred.id}.title`}>
                {t(lang, `credential.${cred.id}.title`)}
              </h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">{cred.issuer}</p>
              <p class="text-xs text-gray-500 dark:text-gray-500">
                {cred.year}
                {cred.inProgress && (
                  <span class="ml-2 rounded-full border border-amber-400/60 bg-amber-100/30 px-2 py-0.5 text-[10px] font-semibold uppercase text-amber-700 dark:border-amber-400/30 dark:bg-amber-500/10 dark:text-amber-300" data-i18n="about.learning.in_progress">{t(lang, 'about.learning.in_progress')}</span>
                )}
                {!cred.inProgress && cred.year && (
                  <span class="ml-2 rounded-full border border-cyan-400/60 bg-cyan-100/30 px-2 py-0.5 text-[10px] font-semibold uppercase text-cyan-700 dark:border-cyan-400/30 dark:bg-cyan-500/10 dark:text-cyan-300" data-i18n="about.learning.completed">{t(lang, 'about.learning.completed')}</span>
                )}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- CURSOS COMPLETADOS -->
    <div class="mt-6 rounded-2xl border border-cyan-100 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
      <h3 class="font-grotesk text-xl font-bold text-black dark:text-white" data-i18n="about.learning.short_courses_title">
        {t(lang, 'about.learning.short_courses_title')}
      </h3>
      <div class="mt-4 grid gap-3" style={`grid-template-columns: repeat(${shortCourses.length === 1 ? 1 : 2}, minmax(0, 1fr))`}>
        {shortCourses.map((cred) => (
          <article id={`cred-${cred.id}`} tabindex="-1" class="flex scroll-mt-28 items-start gap-3 rounded-xl border border-cyan-100 bg-white p-4 outline-none dark:border-white/10 dark:bg-zinc-900/50">
            <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">{cred.icon || 'school'}</span>
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase text-cyan-600 dark:text-cyan-400" data-i18n={`credential.type.${cred.type}`}>
                {t(lang, `credential.type.${cred.type}`)}
              </p>
              <h4 class="font-semibold text-black dark:text-white" data-i18n={`credential.${cred.id}.title`}>
                {t(lang, `credential.${cred.id}.title`)}
              </h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">
                {cred.issuer}{cred.year && ` · ${lang === 'es' ? cred.year : cred.year.replace('Ago.', 'Aug.')}`}{cred.credentialId && ` · ID: ${cred.credentialId}`}
                {cred.pending && <span data-i18n="about.learning.pending"> · {t(lang, 'about.learning.pending')}</span>}
              </p>
              {cred.url && (
                <a class="mt-1 inline-block text-sm font-medium text-cyan-700 underline hover:text-cyan-600 dark:text-cyan-300" href={cred.url} target="_blank" rel="noreferrer" data-i18n="about.learning.view_credential">
                  {t(lang, 'about.learning.view_credential')}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- CERTIFICACIONES EN PREPARACIÓN -->
    {pendingCredentials.length > 0 && (
      <section class="mt-6 rounded-2xl border border-red-300 bg-transparent p-6 dark:border-red-400/40">
        <h3 class="font-grotesk text-xl font-bold text-red-800 dark:text-red-200" data-i18n="about.learning.pending_title">
          {t(lang, 'about.learning.pending_title')}
        </h3>
        <div class="mt-4 space-y-3">
          {pendingCredentials.map((cred) => (
            <article id={`cred-${cred.id}`} tabindex="-1" class="flex scroll-mt-28 items-start gap-3 rounded-xl border border-red-200 bg-transparent p-4 outline-none dark:border-red-400/30">
              <span class="material-symbols-outlined text-red-600 dark:text-red-300">{cred.icon || 'pending_actions'}</span>
              <div>
                <p class="text-xs font-semibold uppercase text-red-700 dark:text-red-300" data-i18n={`credential.type.${cred.type}`}>
                  {t(lang, `credential.type.${cred.type}`)}
                </p>
                <h4 class="font-semibold text-black dark:text-white" data-i18n={`credential.${cred.id}.title`}>
                  {t(lang, `credential.${cred.id}.title`)}
                </h4>
                <p class="text-sm text-gray-700 dark:text-gray-300">{cred.issuer}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- APRENDIZAJE ACTUAL -->
    <div id="aprendizaje-actual" tabindex="-1" class="mt-10 scroll-mt-28 text-center outline-none">
      <h3 class="font-grotesk text-2xl font-bold text-gray-900 dark:text-white" data-i18n="about.learning.current_title">
        {t(lang, 'about.learning.current_title')}
      </h3>
      <p class="mx-auto mt-2 max-w-2xl text-gray-700 dark:text-gray-300" data-i18n="about.learning.current_description">
        {t(lang, 'about.learning.current_description')}
      </p>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        {currentLearning.map((item) => (
          <span class="rounded-full border border-cyan-200 bg-white px-3 py-1 text-sm text-cyan-800 dark:border-cyan-400/30 dark:bg-zinc-900 dark:text-cyan-300">
            {item}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
