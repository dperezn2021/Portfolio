---
import SectionTitle from '../common/SectionTitle.astro';

const tools = [
  { name: '3ds Max', icon: '3d_rotation' },
  { name: 'Unity', icon: 'sports_esports' },
  { name: 'Photoshop', icon: 'brush' },
  { name: 'Figma', icon: 'design_services' },
  { name: 'Illustrator', icon: 'palette' },
  { name: 'ZBrush', icon: 'sculpture' },
  { name: 'After Effects', icon: 'movie' },
  { name: 'Blender', icon: 'modeling' },
];
---

<section class="py-16 transition-colors duration-300 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionTitle titleKey="about.tools_title" subtitleKey="about.tools_subtitle" centered>
      <span slot="title">Herramientas que manejo</span>
      <span slot="subtitle">Software y tecnologías en mi stack</span>
    </SectionTitle>

    <div class="mt-10 md:mt-12 grid grid-cols-2 gap-4 md:grid-cols-4">
      {tools.map((tool) => (
        <div class="glass-card flex flex-col items-center rounded-xl border border-gray-200 bg-white p-6 text-center shadow-sm transition hover:bg-white dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
          <span class="material-symbols-outlined text-4xl text-cyan-600 dark:text-cyan-400">
            {tool.icon}
          </span>
          <span class="mt-2 font-medium text-gray-800 dark:text-gray-200">{tool.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>