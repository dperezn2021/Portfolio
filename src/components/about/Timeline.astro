---
import { t } from '../../data/translations';
import type { Language } from '../../utils/url';
import { timeline } from '../../data/timeline';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;

const dots = [
  'bg-cyan-500 dark:bg-cyan-400 shadow-lg shadow-cyan-500/30 ring-4 ring-cyan-500/10 dark:ring-cyan-400/10',
  'bg-cyan-500/60 dark:bg-cyan-400/50 ring-4 ring-cyan-500/5 dark:ring-cyan-400/5',
  'bg-cyan-500/30 dark:bg-cyan-400/30 ring-4 ring-cyan-500/5 dark:ring-cyan-400/5',
];
const items = timeline.map((item, index) => ({ ...item, dot: dots[index] ?? dots[dots.length - 1] }));
---

<section class="py-16 transition-colors duration-300 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <h2 class="section-title text-center" data-i18n="about.journey_title">
      {t(lang, 'about.journey_title')}
    </h2>
    <p class="section-subtitle text-center" data-i18n="about.journey_subtitle">
      {t(lang, 'about.journey_subtitle')}
    </p>

    <div class="mt-10 md:mt-12 border-l-2 border-cyan-400/50 dark:border-cyan-400/30 ml-4 space-y-8 md:ml-6">
      {items.map((item) => (
        <div id={`timeline-${item.n}`} tabindex="-1" class="relative scroll-mt-28 pl-6 outline-none md:pl-8">
          <div class={`absolute -left-2.25 top-1.5 h-4 w-4 rounded-full ${item.dot}`}></div>
          <span class="inline-block rounded-full bg-cyan-100/60 px-3 py-0.5 text-xs font-semibold text-cyan-700 dark:bg-cyan-400/10 dark:text-cyan-300" data-i18n={`about.timeline.period${item.n}`}>
            {t(lang, `about.timeline.period${item.n}`)}
          </span>
          <h3 class="mt-2 font-grotesk text-xl font-bold text-gray-900 dark:text-white" data-i18n={`about.timeline.title${item.n}`}>
            {t(lang, `about.timeline.title${item.n}`)}
          </h3>
          <p class="text-sm text-cyan-600 dark:text-cyan-400">{item.issuer}</p>
          <p class="mt-2 text-gray-700 dark:text-gray-300" data-i18n={`about.timeline.desc${item.n}`}>
            {t(lang, `about.timeline.desc${item.n}`)}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
