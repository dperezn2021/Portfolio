---
import type { Language } from '../../utils/url';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<section class="py-16 transition-colors duration-300 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <h2 class="section-title text-center" data-i18n="about.journey_title">
      {isEs ? 'Mi Trayectoria' : 'My Journey'}
    </h2>
    <p class="section-subtitle text-center" data-i18n="about.journey_subtitle">
      {isEs ? 'Un recorrido por mi formación y experiencia' : 'A journey through my education and experience'}
    </p>

    <div class="mt-10 md:mt-12 border-l-2 border-cyan-400/50 dark:border-cyan-400/30 ml-4 space-y-8 md:ml-6">
      <!-- Timeline Item 1 -->
      <div class="relative pl-6 md:pl-8">
        <div class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full bg-cyan-500 dark:bg-cyan-400 shadow-lg shadow-cyan-500/30 ring-4 ring-cyan-500/10 dark:ring-cyan-400/10"></div>
        <span class="inline-block rounded-full bg-cyan-100/60 px-3 py-0.5 text-xs font-semibold text-cyan-700 dark:bg-cyan-400/10 dark:text-cyan-300" data-i18n="about.timeline.period1">
          Febrero 2025 — Actualidad
        </span>
        <h3 class="mt-2 font-grotesk text-xl font-bold text-gray-900 dark:text-white" data-i18n="about.timeline.title1">
          Analista de Soporte y Mantenimiento de Aplicaciones
        </h3>
        <p class="text-sm text-cyan-600 dark:text-cyan-400">EPAM Systems · Atresmedia</p>
        <p class="mt-2 text-gray-700 dark:text-gray-300" data-i18n="about.timeline.desc1">
          Soporte y mantenimiento de aplicaciones, resolución de incidencias técnicas y mejora continua de procesos. Monitorización y análisis de logs para optimizar el rendimiento de las aplicaciones y garantizar la satisfacción del usuario.
        </p>
      </div>

      <!-- Timeline Item 2 -->
      <div class="relative pl-6 md:pl-8">
        <div class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full bg-cyan-500/60 dark:bg-cyan-400/50 ring-4 ring-cyan-500/5 dark:ring-cyan-400/5"></div>
        <span class="inline-block rounded-full bg-cyan-100/60 px-3 py-0.5 text-xs font-semibold text-cyan-700 dark:bg-cyan-400/10 dark:text-cyan-300" data-i18n="about.timeline.period2">
          Septiembre 2021 — Julio 2026
        </span>
        <h3 class="mt-2 font-grotesk text-xl font-bold text-gray-900 dark:text-white" data-i18n="about.timeline.title2">
          Grado en Diseño y Desarrollo de Videojuegos
        </h3>
        <p class="text-sm text-cyan-600 dark:text-cyan-400">Universidad Rey Juan Carlos</p>
        <p class="mt-2 text-gray-700 dark:text-gray-300" data-i18n="about.timeline.desc2">
          Formación integral en diferentes lenguajes de programación, herramientas de desarrollo, modelado 3D, animación, narrativa y diseño de niveles para videojuegos.
        </p>
      </div>

      <!-- Timeline Item 3 -->
      <div class="relative pl-6 md:pl-8">
        <div class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full bg-cyan-500/30 dark:bg-cyan-400/30 ring-4 ring-cyan-500/5 dark:ring-cyan-400/5"></div>
        <span class="inline-block rounded-full bg-cyan-100/60 px-3 py-0.5 text-xs font-semibold text-cyan-700 dark:bg-cyan-400/10 dark:text-cyan-300" data-i18n="about.timeline.period3">
          Junio 2021
        </span>
        <h3 class="mt-2 font-grotesk text-xl font-bold text-gray-900 dark:text-white" data-i18n="about.timeline.title3">
          Prueba de acceso a la universidad - EVAU
        </h3>
        <p class="mt-2 text-gray-700 dark:text-gray-300" data-i18n="about.timeline.desc3">
          Superación de la prueba de acceso a la universidad, obteniendo una calificación de 10.526 sobre 14. Esto me permitió acceder al Grado en Diseño y Desarrollo de Videojuegos en la Universidad Rey Juan Carlos.
        </p>
      </div>

      <!-- Timeline Item 4 -->
      <div class="relative pl-6 md:pl-8">
        <div class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full bg-cyan-500/30 dark:bg-cyan-400/30 ring-4 ring-cyan-500/5 dark:ring-cyan-400/5"></div>
        <span class="inline-block rounded-full bg-cyan-100/60 px-3 py-0.5 text-xs font-semibold text-cyan-700 dark:bg-cyan-400/10 dark:text-cyan-300" data-i18n="about.timeline.period4">
          Septiembre 2019 — Mayo 2021
        </span>
        <h3 class="mt-2 font-grotesk text-xl font-bold text-gray-900 dark:text-white" data-i18n="about.timeline.title4">
          Graduado en Bachillerato Científico-Tecnológico
        </h3>
        <p class="text-sm text-cyan-600 dark:text-cyan-400">IES La Laguna, Parla</p>
        <p class="mt-2 text-gray-700 dark:text-gray-300" data-i18n="about.timeline.desc4">
          Formación en ciencias, matemáticas, física y tecnología, con un enfoque en el desarrollo de habilidades analíticas y de resolución de problemas. Preparación para estudios superiores en ingeniería.
        </p>
      </div>
    </div>
  </div>
</section>