---
import SectionTitle from '../common/SectionTitle.astro';

const highlights = [
  { label: 'Años de experiencia', value: '3+' },
  { label: 'Proyectos lanzados', value: '21+' },
  { label: 'Especialidades', value: '4' },
];

const skills = [
  { name: 'Diseño de sistemas y gameplay', value: 90 },
  { name: 'Arte técnico y shaders', value: 88 },
  { name: 'Programación en Unity / C#', value: 84 },
  { name: 'Web y experiencias interactivas', value: 80 },
];

const tools = ['Unity', 'C#', 'Blender', 'Photoshop', 'Figma', 'Astro', 'Tailwind', 'Git'];
---

<section class="bg-white py-20 transition-colors duration-300 dark:bg-zinc-900/40">
  <div class="mx-auto max-w-7xl px-6">
    <SectionTitle titleKey="about.cv_title" subtitleKey="about.cv_subtitle" centered>
      <span slot="title">CV Digital</span>
      <span slot="subtitle">Una vista rápida de mi perfil, trayectoria y herramientas.</span>
    </SectionTitle>

    <div class="mt-12 grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="glass-card rounded-2xl border-gray-200 bg-white/90 p-8 dark:border-white/10 dark:bg-zinc-900/60">
        <div class="inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-4 py-1.5 text-sm font-medium text-cyan-600 dark:border-cyan-400/30 dark:text-cyan-400">
          <span class="h-2 w-2 animate-pulse rounded-full bg-cyan-500"></span>
          Disponible para nuevos retos
        </div>

        <h3 class="mt-6 font-grotesk text-2xl font-bold text-gray-800 dark:text-white">
          Diseñador y desarrollador de videojuegos
        </h3>
        <p class="mt-4 text-lg leading-relaxed text-black dark:text-gray-300">
          Creo experiencias interactivas con una base sólida en gameplay, arte técnico y desarrollo de producto.
          Me enfoco en combinar visión creativa, ejecución técnica y una comunicación clara con equipos y clientes.
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          {['Trabajo en equipo', 'Liderazgo', 'Comunicación', 'Creatividad'].map((tag) => (
            <span class="rounded-full border border-gray-200 bg-white/70 px-3 py-1 text-sm text-gray-700 dark:border-white/10 dark:bg-zinc-800/60 dark:text-gray-300">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <div class="glass-card rounded-2xl border-gray-200 bg-white/90 p-8 dark:border-white/10 dark:bg-zinc-900/60">
        <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          {highlights.map((item) => (
            <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-zinc-800/50 dark:shadow-none">
              <p class="text-2xl font-bold text-cyan-600 dark:text-cyan-400">{item.value}</p>
              <p class="mt-1 text-sm text-black dark:text-black">{item.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <div class="glass-card rounded-2xl border-gray-200 bg-white/90 p-8 dark:border-white/10 dark:bg-zinc-900/60">
        <h3 class="font-grotesk text-xl font-bold text-gray-800 dark:text-white">Experiencia profesional</h3>
        <div class="mt-5 space-y-4">
          <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-zinc-800/50 dark:shadow-none">
            <p class="text-sm font-semibold uppercase tracking-wide text-cyan-600 dark:text-cyan-400">2021 — Actualidad</p>
            <p class="mt-2 font-semibold text-gray-800 dark:text-white">Lead Technical Artist</p>
            <p class="mt-1 text-sm text-black dark:text-black">
              Desarrollo de sistemas visuales, pipelines y optimizaciones para proyectos interactivos de alto nivel.
            </p>
          </div>
          <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-zinc-800/50 dark:shadow-none">
            <p class="text-sm font-semibold uppercase tracking-wide text-cyan-600 dark:text-cyan-400">2018 — 2021</p>
            <p class="mt-2 font-semibold text-gray-800 dark:text-white">Game Developer</p>
            <p class="mt-1 text-sm text-black dark:text-black">
              Integración de mecánicas, contenido interactivo y herramientas para experiencias de juego.
            </p>
          </div>
        </div>
      </div>

      <div class="glass-card rounded-2xl border-gray-200 bg-white/90 p-8 dark:border-white/10 dark:bg-zinc-900/60">
        <h3 class="font-grotesk text-xl font-bold text-gray-800 dark:text-white">Educación</h3>
        <div class="mt-5 space-y-4">
          <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-zinc-800/50 dark:shadow-none">
            <p class="text-sm font-semibold uppercase tracking-wide text-cyan-600 dark:text-cyan-400">2015 — 2018</p>
            <p class="mt-2 font-semibold text-gray-800 dark:text-white">Diseño y desarrollo de videojuegos</p>
            <p class="mt-1 text-sm text-black dark:text-black">
              Formación sólida en creación de juegos, experiencia de usuario e implementación técnica.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
      <div class="glass-card rounded-2xl border-gray-200 bg-white/90 p-8 dark:border-white/10 dark:bg-zinc-900/60">
        <h3 class="font-grotesk text-xl font-bold text-gray-800 dark:text-white">Competencias técnicas</h3>
        <div class="mt-5 space-y-4">
          {skills.map((skill) => (
            <div>
              <div class="mb-2 flex items-center justify-between">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{skill.name}</span>
                <span class="text-sm font-semibold text-cyan-600 dark:text-cyan-400">{skill.value}%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full border border-cyan-100 bg-white dark:border-white/10 dark:bg-zinc-800">
                <div class="h-full rounded-full bg-linear-to-r from-cyan-500 to-fuchsia-500" style={{ width: `${skill.value}%` }}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="glass-card rounded-2xl border-gray-200 bg-white/90 p-8 dark:border-white/10 dark:bg-zinc-900/60">
        <h3 class="font-grotesk text-xl font-bold text-gray-800 dark:text-white">Herramientas favoritas</h3>
        <div class="mt-5 flex flex-wrap gap-3">
          {tools.map((tool) => (
            <span class="rounded-full border border-gray-200 bg-white/70 px-3 py-2 text-sm text-gray-700 dark:border-white/10 dark:bg-zinc-800/60 dark:text-gray-300">
              {tool}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
