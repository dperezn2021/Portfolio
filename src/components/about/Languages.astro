---
import SectionTitle from '../common/SectionTitle.astro';

const languages = [
  { name: 'C#', icon: 'code' },
  { name: 'JavaScript', icon: 'javascript' },
  { name: 'TypeScript', icon: 'data_array' },
  { name: 'Python', icon: 'terminal' },
  { name: 'HTML5', icon: 'html' },
  { name: 'CSS3', icon: 'css' },
];
---

<section class="py-16 transition-colors duration-300 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionTitle titleKey="about.languages_title" subtitleKey="about.languages_subtitle" centered>
      <span slot="title">Lenguajes de Programación</span>
      <span slot="subtitle">Lenguajes que domino</span>
    </SectionTitle>

    <div class="mt-10 md:mt-12 grid grid-cols-2 gap-4 md:grid-cols-3">
      {languages.map((lang) => (
        <div class="glass-card flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition hover:bg-white dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
          <span class="material-symbols-outlined text-3xl text-cyan-600 dark:text-cyan-400">
            {lang.icon}
          </span>
          <span class="font-medium text-gray-800 dark:text-gray-200">{lang.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>