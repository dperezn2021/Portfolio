---
import { site } from '../../data/settings';
import SectionTitle from '../common/SectionTitle.astro';
import { withBasePath } from '../../utils/paths';
import { t } from '../../data/translations';
import type { Language } from '../../utils/url';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
---

<section class="py-16 transition-colors duration-300 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionTitle titleKey="about.title" subtitleKey="about.subtitle" centered>
      <span slot="title">{t(lang, 'about.title')}</span>
      <span slot="subtitle">{t(lang, 'about.subtitle')}</span>
    </SectionTitle>

    <div class="mt-10 md:mt-12 grid grid-cols-1 gap-1 md:grid-cols-2">
      <!-- Foto -->
      <div class="flex justify-center">
        <div class="aspect-square w-full max-w-md overflow-hidden rounded-2xl bg-linear-to-br from-cyan-400/20 to-fuchsia-500/20 p-1">
          <img
            src={withBasePath('/images/extra/fotoDani.jpg')}
            alt={site.name}
            class="h-full w-full rounded-2xl object-cover"
          />
        </div>
      </div>

      <!-- Información -->
      <div class="flex flex-col justify-center space-y-6">
        <div>
          <h2 class="text-3xl font-bold card-title">{site.name}</h2>
          <p class="text-xl text-cyan-600 dark:text-cyan-400" data-i18n="profile.title">
            {t(lang, 'profile.title')}
          </p>
          <p class="text-black/70 dark:text-black" data-i18n="profile.job">
            {t(lang, 'profile.job')}
          </p>
        </div>

        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">location_on</span>
            <span class="text-black dark:text-gray-300">{site.location}</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">email</span>
            <span class="text-black dark:text-gray-300">{site.email}</span>
          </div>
        </div>

        <div>
          <h3 class="font-grotesk text-2xl font-bold card-title" data-i18n="about.resume_title">
            Resumen
          </h3>
          <p class="mt-2 text-black dark:text-gray-300" data-i18n="about.resume">
            {t(lang, 'about.resume')}
          </p>
          <p class="mt-3 text-black dark:text-gray-300" data-i18n="about.resume_2">
            {t(lang, 'about.resume_2')}
          </p>
          <p class="mt-3 text-black dark:text-gray-300" data-i18n="about.resume_3">
            {t(lang, 'about.resume_3')}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>