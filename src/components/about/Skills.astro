---
// src/components/about/Skills.astro
import SectionTitle from '../common/SectionTitle.astro';
import { skills } from '../../data/skills';
import { publicProjects } from '../../data/projects';
import { t } from '../../data/translations';
import { withBasePath } from '../../utils/paths';
import type { Language } from '../../utils/url';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<section class="py-16 transition-colors duration-300 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionTitle titleKey="about.skills_title" subtitleKey="about.skills_subtitle" centered>
      <span slot="title">{isEs ? 'Habilidades Técnicas' : 'Technical Skills'}</span>
      <span slot="subtitle">{isEs ? 'Competencias y capacidades desarrolladas' : 'Competencies and developed capabilities'}</span>
    </SectionTitle>

    <div class="mt-10 md:mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      {skills.map((skill) => (
        <div class="glass-card rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
          <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">{skill.icon}</span>
            <h3 class="font-medium text-gray-800 dark:text-gray-200">{isEs ? skill.name.es : skill.name.en}</h3>
          </div>
          <p class="mt-4 text-xs font-semibold uppercase text-gray-500 dark:text-gray-400">
            {isEs ? 'Proyectos relacionados' : 'Related projects'}
          </p>
          <div class="mt-2 flex flex-wrap gap-2">
            {skill.projectSlugs.map((slug) => {
              const project = publicProjects.find((item) => item.slug === slug);
              if (!project) return null;
              return (
                <a
                  href={withBasePath(`/proyectos/${slug}`)}
                  class="rounded-full border border-cyan-200 bg-white px-3 py-1 text-xs font-medium text-cyan-800 transition hover:border-cyan-500 hover:text-cyan-700 dark:border-cyan-400/30 dark:bg-zinc-900 dark:text-cyan-300"
                  data-i18n={`project.${slug}.title`}
                >
                  {t(lang, `project.${slug}.title`)}
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>