---
// src/components/about/Skills.astro
import SectionTitle from '../common/SectionTitle.astro';
import { skills } from '../../data/skills';
import type { Language } from '../../utils/url';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<section class="py-16 transition-colors duration-300 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionTitle titleKey="about.skills_title" subtitleKey="about.skills_subtitle" centered>
      <span slot="title">{isEs ? 'Habilidades Técnicas' : 'Technical Skills'}</span>
      <span slot="subtitle">{isEs ? 'Competencias y capacidades desarrolladas' : 'Competencies and developed capabilities'}</span>
    </SectionTitle>

    <div class="mt-10 md:mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      {skills.map((skill) => (
        <div class="glass-card rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              {skill.icon && (
                <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">
                  {skill.icon}
                </span>
              )}
              <span class="font-medium text-gray-800 dark:text-gray-200">{skill.name}</span>
            </div>
            <span class="text-sm font-bold text-cyan-600 dark:text-cyan-400">{skill.level}%</span>
          </div>
          <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-gray-200 dark:bg-white/10">
            <div 
              class="h-full rounded-full bg-gradient-to-r from-cyan-500 to-purple-500 transition-all duration-1000 ease-out"
              style={{ width: `${skill.level}%` }}
            ></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>