---
import SectionTitle from '../common/SectionTitle.astro';
import { skills } from '../../data/skills';
---

<section class="py-16 transition-colors duration-300 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionTitle titleKey="about.skills_title" subtitleKey="about.skills_subtitle" centered>
      <span slot="title">Habilidades Técnicas</span>
      <span slot="subtitle">Dominio de herramientas y tecnologías</span>
    </SectionTitle>

    <div class="mt-10 md:mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
      {skills.map((skill) => (
        <div class="space-y-2">
          <div class="flex justify-between">
            <span class="font-medium text-black dark:text-gray-200">{skill.name}</span>
            <span class="text-sm text-black/70 dark:text-black">{skill.level}%</span>
          </div>
          <div class="h-2 overflow-hidden rounded-full border border-cyan-100 bg-white dark:border-white/10 dark:bg-zinc-800">
            <div
              class="h-full rounded-full"
              style={{
                width: `${skill.level}%`,
                background: 'linear-gradient(135deg, #00dbe7 0%, #b600f8 100%)',
              }}
            ></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>