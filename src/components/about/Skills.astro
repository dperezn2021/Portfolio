---
// src/components/about/Skills.astro — Áreas de trabajo respaldadas por proyectos
import SectionTitle from '../common/SectionTitle.astro';
import Localized from '../common/Localized.astro';
import { skills } from '../../data/skills';
import { publicProjects } from '../../data/projects';
import { t } from '../../data/translations';
import { withBasePath } from '../../utils/paths';
import type { Language } from '../../utils/url';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
---

<section class="py-16 transition-colors duration-300 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionTitle titleKey="about.skills_title" subtitleKey="about.skills_subtitle" centered>
      <span slot="title">{t(lang, 'about.skills_title')}</span>
      <span slot="subtitle">{t(lang, 'about.skills_subtitle')}</span>
    </SectionTitle>

    <div class="mt-10 md:mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      {skills.map((skill) => {
        const projects = skill.projectSlugs
          .map((slug) => publicProjects.find((item) => item.slug === slug))
          .filter((project) => project !== undefined);
        const hasEvidence = projects.length > 0 || (skill.extras?.length ?? 0) > 0;

        return (
          <div id={`area-${skill.id}`} tabindex="-1" class="glass-card scroll-mt-28 rounded-xl outline-none border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">{skill.icon}</span>
              <h3 class="font-medium text-gray-800 dark:text-gray-200">
                <Localized text={skill.name} />
              </h3>
            </div>
            <Localized text={skill.description} as="p" class="mt-3 text-sm text-gray-700 dark:text-gray-300" />
            {hasEvidence && (
              <>
                {skill.evidenceLabel ? (
                  <Localized text={skill.evidenceLabel} as="p" class="mt-4 text-xs font-semibold uppercase text-gray-500 dark:text-gray-400" />
                ) : (
                  <p class="mt-4 text-xs font-semibold uppercase text-gray-500 dark:text-gray-400" data-i18n="about.skills_related">
                    {t(lang, 'about.skills_related')}
                  </p>
                )}
                <div class="mt-2 flex flex-wrap gap-2">
                  {projects.map((project) => (
                    <a
                      href={withBasePath(`/proyectos/${project.slug}`)}
                      class="rounded-full border border-cyan-200 bg-white px-3 py-1 text-xs font-medium text-cyan-800 transition hover:border-cyan-500 hover:text-cyan-700 dark:border-cyan-400/30 dark:bg-zinc-900 dark:text-cyan-300"
                      data-i18n={`project.${project.slug}.title`}
                    >
                      {t(lang, `project.${project.slug}.title`)}
                    </a>
                  ))}
                  {skill.extras?.map((extra) => (
                    <Localized
                      text={extra}
                      class="rounded-full border border-gray-300 bg-white px-3 py-1 text-xs font-medium text-gray-700 dark:border-white/20 dark:bg-zinc-900 dark:text-gray-300"
                    />
                  ))}
                </div>
              </>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>