---
// src/components/about/ToolsGrid.astro
import type { Language } from '../../utils/url';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';

// ✅ HERRAMIENTAS BASADAS EN TUS PROYECTOS REALES
const tools = {
  mainApps: [
    { name: '3ds Max', icon: '3d_rotation' },        // Fantasy Island, Raki, Raki Animación, Whispers of Shadows
    { name: 'Unity', icon: 'sports_esports' },        // Astrofury, Histeria, Raki Animación
    { name: 'Visual Studio Code', icon: 'code' },       // Go For Sports
    { name: 'Photoshop', icon: 'brush' },             // Gorobeia, Sí Señor Oscuro, Yumala
    { name: 'Figma', icon: 'design_services' },       // Go For Sports
    { name: 'Github', icon: 'terminal' },       // Go For Sports
    { name: 'Canva', icon: 'brush' },       // Go For Sports
    { name: 'DBeaver', icon: 'storage' },       // Go For Sports
    { name: 'Jira', icon: 'assignment' },       // Go For Sports
    { name: 'Microsoft Visual 2022', icon: 'terminal' },       // Go For Sports
  ],
  otherApps: [
    { name: 'Sketchup', icon: '3d_rotation' },        // Fantasy Island
    { name: 'Android Studio', icon: 'android' },      // Flappy Chef
    { name: 'Canva', icon: 'design_services' },       // Redes Sociales
    { name: 'Substance Painter', icon: 'brush' },     // Raki
    { name: 'Davinci Resolve', icon: 'video_library' },     // Raki
    { name: 'Miro', icon: 'groups' },     // Raki
    { name: 'Blender', icon: '3d_rotation' },     // Raki
    { name: 'MongoDB', icon: 'storage' },     // Raki
    { name: 'Springboot', icon: 'terminal' },     // Raki
    { name: 'Postman', icon: 'assignment' },     // Raki
  ],
  languages: [
    { name: 'HTML5', icon: 'html' },                  // Menteando, International Warfare
    { name: 'CSS3', icon: 'css' },                    // Menteando, International Warfare
    { name: 'JavaScript', icon: 'javascript' },       // AlienRush, HitAndUfo, Menteando
    { name: 'C#', icon: 'code' },                     // Astrofury, Histeria
    { name: 'Astro', icon: 'data_array' },       // Menteando
    { name: 'SQL', icon: 'database' },                // (lo tienes en skills)
  ],
  otherLanguages: [
    { name: 'Python', icon: 'terminal' },             // (lo tienes en skills)
    { name: 'Kotlin', icon: 'android' },              // Flappy Chef
    { name: 'C++', icon: 'php' },                     // (lo tienes en skills)
    { name: 'Java', icon: 'coffee' },                 // Flappy Chef (secundario)
  ],
};
---

<section class="bg-white py-16 transition-colors duration-300 md:py-20 dark:bg-zinc-900/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Aplicaciones que uso -->
    <h2 class="section-title text-center" data-i18n="about.tools_title">
      {isEs ? 'Aplicaciones que manejo' : 'Tools I use'}
    </h2>
    <p class="section-subtitle text-center" data-i18n="about.tools_subtitle">
      {isEs ? 'Software y tecnologías en mi stack' : 'Software and technologies in my stack'}
    </p>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
      {tools.mainApps.map((tool) => (
        <div class="flex flex-col items-center rounded-xl border border-cyan-100 bg-white p-6 text-center shadow-sm transition-all duration-300 hover:-translate-y-2 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
          <span class="material-symbols-outlined text-4xl text-cyan-600 dark:text-cyan-400">
            {tool.icon}
          </span>
          <span class="mt-2 font-medium text-gray-800 dark:text-gray-200">{tool.name}</span>
        </div>
      ))}
    </div>

    <!-- Separador -->
    <div class="my-12 flex items-center gap-4">
      <div class="h-px flex-1 bg-cyan-100 dark:bg-white/10"></div>
      <span class="text-sm font-medium text-gray-500 dark:text-gray-400" data-i18n="about.tools_other_title">
        {isEs ? 'Otras herramientas' : 'Other tools'}
      </span>
      <div class="h-px flex-1 bg-cyan-100 dark:bg-white/10"></div>
    </div>

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
      {tools.otherApps.map((tool) => (
        <div class="flex flex-col items-center rounded-xl border border-cyan-100 bg-white p-5 text-center shadow-sm transition-all duration-300 hover:-translate-y-2 opacity-80 hover:opacity-100 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
          <span class="material-symbols-outlined text-3xl text-cyan-500/70 dark:text-cyan-400/70">
            {tool.icon}
          </span>
          <span class="mt-2 text-sm font-medium text-gray-700 dark:text-gray-300">{tool.name}</span>
        </div>
      ))}
    </div>

    <!-- Lenguajes de programación -->
    <div class="mt-16">
      <h2 class="section-title text-center" data-i18n="about.languages_title">
        {isEs ? 'Lenguajes de Programación' : 'Programming Languages'}
      </h2>
      <p class="section-subtitle text-center" data-i18n="about.languages_subtitle">
        {isEs ? 'Lenguajes que domino' : 'Languages I master'}
      </p>

      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
        {tools.languages.map((langItem) => (
          <div class="flex items-center gap-3 rounded-xl border border-cyan-100 bg-white p-4 shadow-sm transition-all duration-300 hover:-translate-y-2 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
            <span class="material-symbols-outlined text-2xl text-cyan-600 dark:text-cyan-400">
              {langItem.icon}
            </span>
            <span class="font-medium text-gray-800 dark:text-gray-200">{langItem.name}</span>
          </div>
        ))}
      </div>

      <!-- Otros lenguajes -->
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
        {tools.otherLanguages.map((langItem) => (
          <div class="flex items-center gap-3 rounded-xl border border-cyan-100 bg-white p-3 shadow-sm transition-all duration-300 hover:-translate-y-2 opacity-70 hover:opacity-100 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
            <span class="material-symbols-outlined text-xl text-cyan-500/60 dark:text-cyan-400/60">
              {langItem.icon}
            </span>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{langItem.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>