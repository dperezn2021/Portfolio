---
// src/components/about/ToolsGrid.astro — herramientas principales por finalidad + lenguajes y tecnologías
import Localized from '../common/Localized.astro';
import { t } from '../../data/translations';
import type { Language } from '../../utils/url';
import { languages, mainToolGroups, otherLanguages, otherTools, toolSlug } from '../../data/tools';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;
---

<section id="herramientas" class="scroll-mt-20 bg-white py-16 transition-colors duration-300 md:py-20 dark:bg-zinc-900/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Herramientas principales -->
    <h2 class="section-title text-center" data-i18n="about.tools_title">
      {t(lang, 'about.tools_title')}
    </h2>
    <p class="section-subtitle text-center" data-i18n="about.tools_subtitle">
      {t(lang, 'about.tools_subtitle')}
    </p>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {mainToolGroups.map((group) => (
        <div class="rounded-xl border border-cyan-100 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-cyan-600 dark:text-cyan-400">
            <Localized text={group.label} />
          </h3>
          <div class="mt-3 grid grid-cols-1 gap-2">
            {group.tools.map((tool) => (
              <div id={`tool-${toolSlug(tool.name)}`} tabindex="-1" class="scroll-mt-28 flex items-center gap-3 rounded-lg border border-cyan-100/60 bg-white px-3 py-2 outline-none transition-all duration-300 hover:-translate-y-0.5 dark:border-white/10 dark:bg-zinc-900/30">
                <span class="material-symbols-outlined text-2xl text-cyan-600 dark:text-cyan-400">{tool.icon}</span>
                <span class="font-medium text-gray-800 dark:text-gray-200">{tool.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Otras herramientas -->
    <details id="otras-herramientas" class="scroll-mt-28 mt-6 rounded-xl border border-cyan-100 bg-white p-4 dark:border-white/10 dark:bg-zinc-900/40">
      <summary class="flex cursor-pointer list-none items-center gap-2">
        <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">build</span>
        <span class="font-semibold text-gray-800 dark:text-gray-200" data-i18n="about.tools_other_title">
          {t(lang, 'about.tools_other_title')}
        </span>
        <span class="ml-auto material-symbols-outlined text-gray-500 dark:text-gray-400">expand_more</span>
      </summary>
      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
        {otherTools.map((tool) => (
          <div id={`tool-${toolSlug(tool.name)}`} tabindex="-1" class="scroll-mt-28 flex items-center gap-2 rounded-lg border border-cyan-100/60 bg-white px-3 py-2 opacity-80 outline-none dark:border-white/10 dark:bg-zinc-900/30">
            <span class="material-symbols-outlined text-xl text-cyan-500/70 dark:text-cyan-400/70">{tool.icon}</span>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{tool.name}</span>
          </div>
        ))}
      </div>
    </details>

    <!-- Lenguajes y tecnologías -->
    <div id="lenguajes" class="scroll-mt-28 mt-16">
      <h2 class="section-title text-center" data-i18n="about.languages_title">
        {t(lang, 'about.languages_title')}
      </h2>
      <p class="section-subtitle text-center" data-i18n="about.languages_subtitle">
        {t(lang, 'about.languages_subtitle')}
      </p>

      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
        {languages.map((item) => (
          <div id={`tool-${toolSlug(item.name)}`} tabindex="-1" class="scroll-mt-28 flex items-center gap-3 rounded-xl border border-cyan-100 bg-white p-4 shadow-sm outline-none transition-all duration-300 hover:-translate-y-2 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
            <span class="material-symbols-outlined text-2xl text-cyan-600 dark:text-cyan-400">{item.icon}</span>
            <span class="font-medium text-gray-800 dark:text-gray-200">{item.name}</span>
          </div>
        ))}
      </div>

      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
        {otherLanguages.map((item) => (
          <div id={`tool-${toolSlug(item.name)}`} tabindex="-1" class="scroll-mt-28 flex items-center gap-3 rounded-xl border border-cyan-100 bg-white p-3 shadow-sm outline-none transition-all duration-300 hover:-translate-y-2 opacity-70 hover:opacity-100 dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
            <span class="material-symbols-outlined text-xl text-cyan-500/60 dark:text-cyan-400/60">{item.icon}</span>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{item.name}</span>
          </div>
        ))}
      </div>

      <p class="mt-6 text-center text-sm text-gray-600 dark:text-gray-400" data-i18n="about.languages_note">
        {t(lang, 'about.languages_note')}
      </p>
    </div>
  </div>
</section>

<script>
  import { focusHashTarget } from '../../utils/focus-hash';
  focusHashTarget();
  window.addEventListener('hashchange', focusHashTarget);
</script>
