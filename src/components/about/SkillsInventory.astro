---
// Inventario de habilidades: destacadas → escala → categorías → conocimientos introductorios
import SectionTitle from '../common/SectionTitle.astro';
import { skillCategories, skillLevels } from '../../data/learning';
import type { SkillKind } from '../../data/learning';
import { categoryAnchor, categorySkills, featuredWithLevel, introSkills, skillAnchor } from '../../data/skills-view';
import { publicProjects } from '../../data/projects';
import { withBasePath } from '../../utils/paths';
import type { Language } from '../../utils/url';
import { t } from '../../data/translations';

interface Props {
  lang?: Language;
}

const { lang = 'es' } = Astro.props;

const categoryIcons: Record<string, string> = {
  game_development: 'sports_esports',
  design: 'brush',
  programming: 'terminal',
  databases: 'database',
  support: 'support_agent',
  streaming: 'play_arrow',
  ai: 'neurology',
  cloud_devops: 'cloud',
};

const getSourceColor = (source: string): string => {
  const colors: Record<string, string> = {
    'Universidad': 'border border-purple-400/50 bg-purple-100/20 text-purple-700 dark:border-purple-400/30 dark:bg-purple-500/10 dark:text-purple-300',
    'Trabajo': 'border border-emerald-400/50 bg-emerald-100/20 text-emerald-700 dark:border-emerald-400/30 dark:bg-emerald-500/10 dark:text-emerald-300',
    'Personal': 'border border-blue-400/50 bg-blue-100/20 text-blue-700 dark:border-blue-400/30 dark:bg-blue-500/10 dark:text-blue-300',
  };
  return colors[source] || 'border border-gray-400/50 bg-gray-100/20 text-gray-700 dark:border-gray-400/30 dark:bg-gray-500/10 dark:text-gray-300';
};

const getLegendColor = (source: string): string => {
  const colors: Record<string, string> = {
    'Universidad': 'bg-purple-500',
    'Trabajo': 'bg-emerald-500',
    'Personal': 'bg-blue-500',
  };
  return colors[source] || 'bg-gray-500';
};

const sourceLabelKey = (source: string): string =>
  source === 'Universidad' ? 'about.learning.tag_university' : source === 'Trabajo' ? 'about.learning.tag_work' : 'about.learning.tag_personal';

const legendItems = ['Universidad', 'Trabajo', 'Personal'];

const featured = featuredWithLevel;

const kinds: SkillKind[] = ['skill', 'tool'];
---

<section class="bg-white py-16 transition-colors duration-300 md:py-20 dark:bg-zinc-900/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionTitle titleKey="skills.title" subtitleKey="skills.subtitle" centered>
      <span slot="title">{t(lang, 'skills.title')}</span>
      <span slot="subtitle">{t(lang, 'skills.subtitle')}</span>
    </SectionTitle>

    <!-- COMPETENCIAS DESTACADAS -->
    <h3 class="mt-10 font-grotesk text-xl font-bold text-black dark:text-white" data-i18n="skills.featured_title">
      {t(lang, 'skills.featured_title')}
    </h3>
    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400" data-i18n="skills.featured_subtitle">
      {t(lang, 'skills.featured_subtitle')}
    </p>
    <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {featured.map((item) => (
        <div class="flex items-center gap-3 rounded-xl border border-cyan-100 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-zinc-900/40 dark:shadow-none">
          <span class="material-symbols-outlined text-3xl text-cyan-600 dark:text-cyan-400">{item.icon}</span>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-black dark:text-white" data-i18n={`featured.${item.id}`}>
              {t(lang, `featured.${item.id}`)}
            </p>
            <div class="mt-1 flex items-center gap-2" role="img" aria-label={`${item.level}/5`}>
              <div class="flex gap-1">
                {skillLevels.map((n) => (
                  <span class={`h-1.5 w-4 rounded-full ${n <= item.level ? 'bg-cyan-500 dark:bg-cyan-400' : 'bg-gray-200 dark:bg-white/15'}`}></span>
                ))}
              </div>
              <span class="text-xs font-medium text-gray-600 dark:text-gray-400">{item.level}/5</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- ESCALA DE AUTOEVALUACIÓN -->
    <div class="mt-10 rounded-2xl border border-cyan-100 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
      <h3 class="font-grotesk text-xl font-bold text-black dark:text-white" data-i18n="skills.scale_title">
        {t(lang, 'skills.scale_title')}
      </h3>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-400" data-i18n="skills.scale_note">
        {t(lang, 'skills.scale_note')}
      </p>
      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {skillLevels.map((n) => (
          <div class="rounded-xl border border-cyan-100 bg-white p-3 dark:border-white/10 dark:bg-zinc-900/50">
            <p class="text-xs font-semibold text-cyan-600 dark:text-cyan-400">{n}/5</p>
            <p class="font-semibold text-black dark:text-white" data-i18n={`level.${n}.name`}>
              {t(lang, `level.${n}.name`)}
            </p>
            <p class="mt-1 text-xs text-gray-600 dark:text-gray-400" data-i18n={`level.${n}.desc`}>
              {t(lang, `level.${n}.desc`)}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- LEYENDA DE ORIGEN -->
    <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-sm">
      {legendItems.map((source) => (
        <span class="flex items-center gap-2">
          <span class={`inline-block h-3 w-3 rounded-full ${getLegendColor(source)}`}></span>
          <span data-i18n={sourceLabelKey(source)}>{t(lang, sourceLabelKey(source))}</span>
        </span>
      ))}
    </div>

    <!-- INVENTARIO POR CATEGORÍAS -->
    <div class="mt-6 rounded-2xl border border-cyan-100 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
      <h3 class="font-grotesk text-xl font-bold text-black dark:text-white" data-i18n="about.learning.skills_title">
        {t(lang, 'about.learning.skills_title')}
      </h3>

      {skillCategories.map((cat) => {
        const skills = categorySkills(cat);
        if (skills.length === 0) return null;
        const hasBothKinds = kinds.every((kind) => skills.some((s) => s.kind === kind));

        return (
          <details id={categoryAnchor(cat)} class="scroll-mt-28 mt-4 rounded-xl border border-cyan-100 bg-white p-4 dark:border-white/10 dark:bg-zinc-900/50">
            <summary class="flex cursor-pointer list-none items-center gap-2">
              <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">
                {categoryIcons[cat] || 'circle'}
              </span>
              <h4 class="font-semibold text-black dark:text-white" data-i18n={`category.${cat}`}>
                {t(lang, `category.${cat}`)}
              </h4>
              <span class="text-xs text-gray-500 dark:text-gray-400">({skills.length})</span>
              <span class="ml-auto material-symbols-outlined text-gray-500 dark:text-gray-400">expand_more</span>
            </summary>
            {kinds.map((kind) => {
              const group = skills.filter((s) => s.kind === kind);
              if (group.length === 0) return null;
              return (
                <>
                  {hasBothKinds && (
                    <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400" data-i18n={`skills.kind_${kind}`}>
                      {t(lang, `skills.kind_${kind}`)}
                    </p>
                  )}
            <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 md:grid-cols-3">
              {group.map((skill) => (
                <div id={skillAnchor(skill)} data-skill-card class="scroll-mt-28 rounded-lg border border-cyan-100/60 bg-white p-3 shadow-sm outline-none dark:border-white/10 dark:bg-zinc-900/30">
                  <span class="text-sm font-medium text-black dark:text-white" data-i18n={`skill.${skill.id}`}>
                    {t(lang, `skill.${skill.id}`)}
                  </span>
                  {skill.level !== undefined ? (
                    <div class="mt-1 flex items-center gap-2" role="img" aria-label={`${skill.level}/5`}>
                      <div class="flex gap-0.5">
                        {skillLevels.map((n) => (
                          <span class={`h-1.5 w-3 rounded-full ${n <= skill.level! ? 'bg-cyan-500 dark:bg-cyan-400' : 'bg-gray-200 dark:bg-white/15'}`}></span>
                        ))}
                      </div>
                      <span class="text-[11px] text-gray-600 dark:text-gray-400">
                        {skill.level}/5 · <span data-i18n={`level.${skill.level}.name`}>{t(lang, `level.${skill.level}.name`)}</span>
                      </span>
                    </div>
                  ) : (
                    <p class="mt-1 text-[11px] italic text-gray-500 dark:text-gray-400" data-i18n="level.pending">
                      {t(lang, 'level.pending')}
                    </p>
                  )}
                  <div class="mt-1 flex flex-wrap gap-1">
                    {skill.sources.map((source) => (
                      <span class={`rounded-full px-2 py-0.5 text-[10px] font-medium ${getSourceColor(source)}`}>
                        <span data-i18n={sourceLabelKey(source)}>{t(lang, sourceLabelKey(source))}</span>
                      </span>
                    ))}
                  </div>
                  <p class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-i18n={`skill.${skill.id}.desc`}>
                    {t(lang, `skill.${skill.id}.desc`)}
                  </p>
                  {(skill.projectSlugs ?? []).some((slug) => publicProjects.some((p) => p.slug === slug)) && (
                    <div class="mt-2 flex flex-wrap gap-1">
                      {(skill.projectSlugs ?? []).map((slug) => {
                        const project = publicProjects.find((p) => p.slug === slug);
                        if (!project) return null;
                        return (
                          <a
                            href={withBasePath(`/proyectos/${slug}`)}
                            class="rounded-full border border-cyan-200 bg-white px-2 py-0.5 text-[10px] font-medium text-cyan-800 transition hover:border-cyan-500 dark:border-cyan-400/30 dark:bg-zinc-900 dark:text-cyan-300"
                            data-i18n={`project.${slug}.title`}
                          >
                            {t(lang, `project.${slug}.title`)}
                          </a>
                        );
                      })}
                    </div>
                  )}
                </div>
              ))}
            </div>
                </>
              );
            })}
          </details>
        );
      })}
    </div>

    <!-- CONOCIMIENTOS INTRODUCTORIOS -->
    {introSkills.length > 0 && (
      <div class="mt-6 rounded-2xl border border-cyan-100 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-zinc-900/40">
        <h3 class="font-grotesk text-xl font-bold text-black dark:text-white" data-i18n="skills.intro_title">
          {t(lang, 'skills.intro_title')}
        </h3>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400" data-i18n="skills.intro_description">
          {t(lang, 'skills.intro_description')}
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {introSkills.map((skill) => (
            <span id={skillAnchor(skill)} data-skill-card tabindex="-1" class="scroll-mt-28 rounded-full border border-cyan-200 bg-white px-3 py-1 text-sm text-cyan-800 outline-none dark:border-cyan-400/30 dark:bg-zinc-900 dark:text-cyan-300" data-i18n={`skill.${skill.id}`}>
              {t(lang, `skill.${skill.id}`)}
            </span>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script>
  import { focusHashTarget } from '../../utils/focus-hash';
  focusHashTarget();
  window.addEventListener('hashchange', focusHashTarget);
</script>
