---
import { site } from '../../data/settings';
import { navigation } from '../../data/navigation';
import type { Language } from '../../utils/url';
import { withBasePath } from '../../utils/paths';
import { t } from '../../data/translations';
import ThemeToggle from '../common/ThemeToggle.astro';
import LanguageToggle from '../common/LanguageToggle.astro';

interface Props {
  currentPage?: string;
  lang?: Language;
}

const { currentPage = '/', lang = 'es' } = Astro.props;
---

<header
  class="fixed top-0 left-0 z-50 w-full transition-colors duration-300"
  id="top-nav"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-2 px-3 py-5 sm:px-6">
    <a href={withBasePath('/')} class="whitespace-nowrap text-base font-bold tracking-tight text-cyan-600 dark:text-cyan-400 sm:text-xl md:text-2xl">
      {site.shortName}
    </a>

    <nav class="hidden md:block">
      <ul class="flex items-center gap-8">
        {navigation.map((item) => (
          <li>
            <a
              href={withBasePath(item.href)}
              class:list={[
                'text-sm font-bold uppercase tracking-widest transition-colors duration-300',
                currentPage === item.href
                  ? 'text-cyan-600 border-b-2 border-cyan-600 pb-1 dark:text-cyan-400 dark:border-cyan-400'
                  : 'text-gray-700 hover:text-cyan-600 dark:text-black dark:hover:text-cyan-400',
              ]}
              data-i18n={item.i18nKey}
            >
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-2 sm:gap-4">
      <a
        id="header-search"
        href={withBasePath('/#buscador')}
        class="hidden h-10 w-10 items-center justify-center rounded-full min-[400px]:flex border border-gray-200 bg-white p-0 shadow-sm transition-colors hover:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 dark:border-white/10 dark:bg-transparent dark:shadow-none dark:hover:bg-white/10"
        aria-label={t(lang, 'search.open')}
        data-i18n-aria="search.open"
      >
        <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400" aria-hidden="true">search</span>
      </a>
      <LanguageToggle lang={lang} />
      <ThemeToggle />
      
      <button
        id="menu-toggle"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="block md:hidden rounded-lg border border-gray-200 bg-white p-2 shadow-sm transition-colors hover:bg-white dark:border-white/10 dark:bg-transparent dark:shadow-none dark:hover:bg-white/10"
        aria-label="Abrir menú / Open menu"
      >
        <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">
          menu
        </span>
      </button>
    </div>
  </div>

  <!-- Menú Móvil -->
  <div
    id="mobile-menu"
    class="hidden md:hidden transition-all duration-300"
  >
    <nav class="px-6 py-4">
      <ul class="flex flex-col gap-4">
        {navigation.map((item) => (
          <li>
            <a
              href={withBasePath(item.href)}
              class:list={[
                'block text-sm font-bold uppercase tracking-widest transition-colors duration-300 py-2',
                currentPage === item.href
                  ? 'text-cyan-600 dark:text-cyan-400'
                  : 'text-gray-700 hover:text-cyan-600 dark:text-black dark:hover:text-cyan-400',
              ]}
              data-i18n={item.i18nKey}
            >
              {item.title}
            </a>
          </li>
        ))}
        <li class="min-[400px]:hidden">
          <a
            href={withBasePath('/#buscador')}
            class="block py-2 text-sm font-bold uppercase tracking-widest text-gray-700 transition-colors duration-300 hover:text-cyan-600 dark:text-black dark:hover:text-cyan-400"
            data-i18n="search.menu"
          >
            {t(lang, 'search.menu')}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    
    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!isOpen));
      const icon = toggle.querySelector('.material-symbols-outlined');
      if (icon) {
        icon.textContent = isOpen ? 'menu' : 'close';
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        const icon = toggle.querySelector('.material-symbols-outlined');
        if (icon) {
          icon.textContent = 'menu';
        }
      });
    });
  });
</script>

<script>
  type TranslationMap = Record<string, Record<string, string>>;

  const syncSearchLabel = () => {
    const link = document.getElementById('header-search');
    if (!(link instanceof HTMLAnchorElement)) return;
    const lang = localStorage.getItem('lang') === 'en' ? 'en' : 'es';
    const label = (window as unknown as { translations?: TranslationMap }).translations?.[lang]?.['search.open'];
    if (label) {
      link.setAttribute('aria-label', label);
    }
  };

  const onSearchClick = (event: MouseEvent) => {
    const link = event.currentTarget;
    if (!(link instanceof HTMLAnchorElement)) return;

    const isHomePage =
      new URL(link.href).pathname.replace(/\/$/, '') === location.pathname.replace(/\/$/, '');
    if (!isHomePage) return;

    event.preventDefault();

    document.getElementById('buscador')?.scrollIntoView({ behavior: 'smooth', block: 'start' });

    const menu = document.getElementById('mobile-menu');
    if (menu && !menu.classList.contains('hidden')) {
      menu.classList.add('hidden');
      const toggleIcon = document.querySelector('#menu-toggle .material-symbols-outlined');
      if (toggleIcon) {
        toggleIcon.textContent = 'menu';
      }
    }

    window.setTimeout(() => {
      document.getElementById('global-search-input')?.focus({ preventScroll: true });
    }, 400);
  };

  document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('header-search')?.addEventListener('click', onSearchClick);
    syncSearchLabel();
  });
  window.addEventListener('app:languagechange', syncSearchLabel);
</script>