---
import { site } from '../../data/settings';
import { navigation } from '../../data/navigation';
import type { Language } from '../../utils/url';
import ThemeToggle from '../common/ThemeToggle.astro';
import LanguageToggle from '../common/LanguageToggle.astro';

interface Props {
  currentPage?: string;
  lang?: Language;
}

const { currentPage = '/', lang = 'es' } = Astro.props;
---

<header
  class="fixed top-0 left-0 z-50 w-full transition-colors duration-300"
  id="top-nav"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5">
    <a href="/" class="text-2xl font-bold tracking-tight text-cyan-600 dark:text-cyan-400">
      {site.shortName}
    </a>

    <nav class="hidden md:block">
      <ul class="flex items-center gap-8">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'text-sm font-bold uppercase tracking-widest transition-colors duration-300',
                currentPage === item.href
                  ? 'text-cyan-600 border-b-2 border-cyan-600 pb-1 dark:text-cyan-400 dark:border-cyan-400'
                  : 'text-gray-700 hover:text-cyan-600 dark:text-black dark:hover:text-cyan-400',
              ]}
              data-i18n={item.i18nKey}
            >
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      <LanguageToggle lang={lang} />
      <ThemeToggle />
      
      <button
        id="menu-toggle"
        class="block md:hidden rounded-lg border border-gray-200 bg-white p-2 shadow-sm transition-colors hover:bg-white dark:border-white/10 dark:bg-transparent dark:shadow-none dark:hover:bg-white/10"
        aria-label="Toggle menu"
      >
        <span class="material-symbols-outlined text-cyan-600 dark:text-cyan-400">
          menu
        </span>
      </button>
    </div>
  </div>

  <!-- Menú Móvil -->
  <div
    id="mobile-menu"
    class="hidden md:hidden transition-all duration-300"
  >
    <nav class="px-6 py-4">
      <ul class="flex flex-col gap-4">
        {navigation.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'block text-sm font-bold uppercase tracking-widest transition-colors duration-300 py-2',
                currentPage === item.href
                  ? 'text-cyan-600 dark:text-cyan-400'
                  : 'text-gray-700 hover:text-cyan-600 dark:text-black dark:hover:text-cyan-400',
              ]}
              data-i18n={item.i18nKey}
            >
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    
    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden');
      const icon = toggle.querySelector('.material-symbols-outlined');
      if (icon) {
        icon.textContent = isOpen ? 'menu' : 'close';
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        const icon = toggle.querySelector('.material-symbols-outlined');
        if (icon) {
          icon.textContent = 'menu';
        }
      });
    });
  });
</script>