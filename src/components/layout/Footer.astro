---
import { site } from '../../data/settings';
import { socials } from '../../data/socials';
---

<footer class="transition-colors duration-300 rounded-t-xl">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-8 px-6 py-10 md:flex-row">
    <div class="flex flex-col items-center gap-2 md:items-start">
      <span class="text-lg font-bold uppercase tracking-tight text-cyan-600 dark:text-cyan-400">
        {site.shortName}
      </span>
      <p class="text-sm text-black dark:text-black" data-i18n="footer.copy">
        © 2024 Daniel Pérez Navarro. Construido para la próxima generación.
      </p>
    </div>

    <div class="flex gap-6">
      {socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-black hover:text-cyan-600 dark:text-black dark:hover:text-cyan-400 transition-colors"
        >
          {social.name}
        </a>
      ))}
    </div>
  </div>
</footer>